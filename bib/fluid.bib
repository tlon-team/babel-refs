	title = {The end of history?},
	journaltitle = {The National Interest},
	number = {16},
	pages = {3--18},
	date = {1989},
	url = {https://www.jstor.org/stable/24027184},
	issn = {0884-9382},
	langid = {english},
	abstract = {Writing as the Cold War was drawing to a close, Fukuyama argues that the world may be witnessing not just the end of the Cold War or of a particular period of postwar history, but the end of history as such: the end point of mankind's ideological evolution and the universalization of Western liberal democracy as the final form of human government. Drawing on a Hegelian reading of history as mediated by Alexandre Kojève, he contends that the victory of liberalism has occurred primarily in the realm of ideas and consciousness, even if it is not yet complete in the material world. He surveys the apparent exhaustion of systematic alternatives to liberalism, including fascism, communism, and reformist movements in China and the Soviet Union, and considers whether religion or nationalism could pose a lasting ideological challenge. He concludes by reflecting on the implications for international relations and on the prospect that post-historical life may be marked by boredom. – AI-generated abstract.}
}

