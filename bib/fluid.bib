@article{Heiding2024DevisingDetectingPhishing,
	langid = {english},
	author = {Heiding, Fred and Schneier, Bruce and Vishwanath, Arun and Bernstein, Jeremy and Park, Peter S.},
	title = {Devising and detecting phishing emails using large language models},
	journaltitle = {IEEE Access},
	shortjournal = {IEEE Access},
	volume = {12},
	pages = {42131--42146},
	doi = {10.1109/ACCESS.2024.3375882},
	url = {https://ieeexplore.ieee.org/document/10466545},
	issn = {2169-3536},
	date = {2024},
	abstract = {AI programs built on top of large language models can automatically generate phishing emails based on limited target information. This work evaluates such attacks against the V-Triad---a set of rules for manually designing phishing emails to exploit cognitive heuristics and biases. In a red-team study emailing 112 study participants, the authors compare phishing performance across four conditions: control emails (click-through rates of 19--28\%), GPT-generated emails (30--44\%), V-Triad emails (69--79\%), and emails combining GPT and the V-Triad (43--81\%). The authors also test the detection capabilities of frontier LLMs (Claude, GPT-4, and others), finding that they frequently outperform commercial spam filters and non-expert humans at identifying suspicious intent. The paper concludes with a discussion of implications for defensive tooling and organisational security awareness. – AI-generated abstract.},
	keywords = {phishing, large language models, cybersecurity, V-Triad, GPT-4, Claude, social engineering}
}

@online{Heiding2024EvaluatingLargeLanguage,
	langid = {english},
	author = {Heiding, Fred and Lermen, Simon and Kao, Andrew and Schneier, Bruce and Vishwanath, Arun},
	title = {Evaluating large language models' capability to launch fully automated spear phishing campaigns: validated on human subjects},
	shorttitle = {Evaluating large language models' capability to launch fully automated spear phishing campaigns},
	journaltitle = {arXiv},
	date = {2024-11-30},
	doi = {10.48550/arXiv.2412.00586},
	url = {https://arxiv.org/abs/2412.00586},
	urldate = {2026-08-06},
	abstract = {The authors evaluate the capability of large language models to conduct personalised phishing attacks and compare their performance with human experts and AI models from the previous year. Four email groups with a combined total of 101 participants were tested: arbitrary phishing emails (12\% click-through), emails generated by human experts (54\%), fully AI-automated emails (54\%), and AI emails using a human in the loop (56\%). AI-automated attacks performed on par with human experts and 350\% better than the control group---a significant improvement over similar studies conducted a year earlier. The AI-gathered target information was accurate and useful in 88\% of cases. Claude 3.5 Sonnet scored above 90\% at detecting phishing intent with low false-positive rates. The authors also analyse the economics of phishing, showing that AI enables attackers to profitably target much larger audiences.},
	keywords = {phishing, large language models, spear phishing, cybersecurity, GPT-4, Claude}
}

@Article{Hendrycks2023NaturalSelectionFavors,
	langid = {english},
	number = {arXiv:2303.16200v4 [cs.CY]},
	file = {~/My Drive/library-pdf/Hendrycks2023NaturalSelectionFavors.pdf},
	abstract = {For billions of years, evolution has been the driving force behind the development of life, including humans. Evolution endowed humans with high intelligence, which allowed us to become one of the most successful species on the planet. Today, humans aim to create artificial intelligence systems that surpass even our own intelligence. As artificial intelligences ({AIs}) evolve and eventually surpass us in all domains, how might evolution shape our relations with {AIs}? By analyzing the environment that is shaping the evolution of {AIs}, we argue that the most successful {AI} agents will likely have undesirable traits. Competitive pressures among corporations and militaries will give rise to {AI} agents that automate human roles, deceive others, and gain power. If such agents have intelligence that exceeds that of humans, this could lead to humanity losing control of its future. More abstractly, we argue that natural selection operates on systems that compete and vary, and that selfish species typically have an advantage over species that are altruistic to other species. This Darwinian logic could also apply to artificial agents, as agents may eventually be better able to persist into the future if they behave selfishly and pursue their own interests with little regard for humans, which could pose catastrophic risks. To counteract these risks and Darwinian forces, we consider interventions such as carefully designing {AI} agents' intrinsic motivations, introducing constraints on their actions, and institutions that encourage cooperation. These steps, or others that resolve the problems we pose, will be necessary in order to ensure the development of artificial intelligence is a positive one.},
	author = {Hendrycks, Dan},
	date = {2023-03-28},
	doi = {10.48550/arXiv.2303.16200},
	timestamp = {2023-04-18 14:55:44 (GMT)},
	title = {Natural Selection Favors {AIs} over Humans},
	url = {https://arxiv.org/abs/2303.16200},
	urldate = {2023-04-18}
}

