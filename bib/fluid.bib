	journaltitle = {LessWrong},
	date = {2016-12-20},
	url = {https://www.lesswrong.com/posts/EEv9JeuY5xfuDDSgF/flinching-away-from-truth-is-often-about-protecting-the},
	urldate = {2026-11-10},
	langid = {english},
	abstract = {A child who wants to be a writer refuses to accept that she misspelled a word, because in her mind the question of whether the word is spelled correctly is stuck together with the question of whether she is allowed to pursue her ambition. The author argues that much apparent flinching away from truth works like this: when several variables share a single "bucket", accepting an unwelcome fact would force false updates elsewhere, and resisting the fact protects the rest of one's beliefs. The remedy is to acquire more buckets, separating the variables so that each can update to the accurate state independently. The post gives further examples of such "bucket errors" and describes how the author avoids them, by asking her mind what it fears would follow from taking in the information and then separating the concerns. – AI-generated abstract.},
	keywords = {rationality, epistemology, motivated reasoning, emotions, belief updating}
}

