@article{Gagnon2013AgeSpecificMortality,
	langid = {english},
	author = {Gagnon, Alain and Miller, Matthew S. and Hallman, Stacey A. and Bourbeau, Robert and Herring, D. Ann and Earn, David J. D. and Madrenas, Joaquín},
	title = {Age-specific mortality during the 1918 influenza pandemic: unravelling the mystery of high young adult mortality},
	journaltitle = {PLoS ONE},
	shortjournal = {PLoS ONE},
	volume = {8},
	number = {8},
	pages = {e69586},
	doi = {10.1371/journal.pone.0069586},
	url = {https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0069586},
	issn = {1932-6203},
	date = {2013-08-05},
	abstract = {The worldwide spread of a novel influenza A (H1N1) virus in 2009 demonstrated that influenza remains a significant public-health threat, even for individuals in the prime of life. This study focuses on the extraordinary young-adult mortality documented during the Spanish flu pandemic of 1918. Using historical mortality data from Canada and the United States, the authors identify a peak in mortality precisely at age 28 during the pandemic, and propose that this elevated mortality resulted from early-life exposure to influenza during the Russian flu pandemic of 1889--90. They argue that immunological memory to an influenza strain acquired in early life can sometimes trigger a dysregulated immune response to antigenically novel strains encountered later, increasing the risk of death, and that early-life exposure during critical developmental windows may also generate gaps in the T-cell repertoire and impair fetal maturation, raising subsequent mortality risk from infectious disease.},
	keywords = {1918 influenza, Spanish flu, age-specific mortality, immunology, historical demography}
}

