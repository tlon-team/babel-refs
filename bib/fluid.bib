	abstract = {Buterin sets out a techno-optimist worldview tempered by explicit concern about the unique risks posed by advanced artificial intelligence. He argues that technology has historically improved human welfare, but that superintelligent AI requires a qualitatively different kind of caution than earlier innovations. He introduces "d/acc" — defensive and decentralised acceleration — as a program that prioritises technologies enhancing individual and collective resilience across physical, biological, and cyber domains, while resisting centralisation of power. Rather than seeking either monopolistic AI governance or blanket technological delay, Buterin advocates a broad R\&D agenda for defensive infrastructure and human-AI cooperation (including brain-computer interfaces) as paths to superintelligence that preserve human agency and democratic values. – AI-generated abstract.},
	keywords = {AI, techno-optimism, d/acc, decentralization, defensive acceleration}
}

