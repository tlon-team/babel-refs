	urldate = {2026-10-27},
	langid = {english},
	abstract = {In this year's issue, we focus on the impact of caring and sharing on people's happiness. Like `mercy' in Shakespeare's Merchant of Venice, caring is ``twice-blessed'' – it blesses those who give and those who receive. In this report, we investigate both of these effects: the benefits to the recipients of caring behaviour and the benefits to those who care for others.},
	keywords = {happiness, subjective wellbeing, life satisfaction, kindness, prosocial behaviour, country rankings}
}

@incollection{Plant2025GivingOthersHow,
	author = {Plant, Michael and McGuire, Joel and Dupret, Samuel and Dwyer, Ryan and Stewart, Ben},
	editor = {Helliwell, John F. and Layard, Richard and Sachs, Jeffrey D. and De Neve, Jan-Emmanuel and Aknin, Lara B. and Wang, Shun},
	title = {Giving to others: how to convert your money into greater happiness for others},
	booktitle = {World {Happiness} {Report} 2025},
	publisher = {Wellbeing Research Centre, University of Oxford},
	location = {Oxford},
	pages = {227--256},
	date = {2025-03-20},
	doi = {10.18724/whr-e0cy-0r69},
	isbn = {9781734808087},
	url = {https://doi.org/10.18724/whr-e0cy-0r69},
	urldate = {2026-10-27},
	langid = {english},
	abstract = {The cost-effectiveness of charities can be measured and compared with a standardised metric of value: wellbeing-years (WELLBYs). In the first global review of published evidence, we find that the cost-effectiveness of charities varies dramatically. The best charities in our sample are hundreds of times better at increasing happiness per dollar than others. Therefore, you can multiply your impact at no extra cost by funding more cost-effective charities. There are no published evaluations of large, well-known charities or typical acts of charitable giving, such as helping the homeless, using a wellbeing approach. We present some rough evaluations of these cases but find them to be less cost-effective than nearly all the charities in our sample.},
	keywords = {charitable giving, cost-effectiveness, WELLBYs, subjective wellbeing, effective giving}
}

@online{Kahneman2011FocusingIllusion,
	author = {Kahneman, Daniel},
	title = {Focusing illusion},
	journaltitle = {Edge},
	date = {2011},
	url = {https://www.edge.org/response-detail/11984},
	urldate = {2026-10-27},
	langid = {english},
	abstract = {In this response to the 2011 Edge annual question, "What scientific concept would improve everybody's cognitive toolkit?", Kahneman proposes the focusing illusion, summarised as "nothing in life is as important as you think it is, while you are thinking about it." He illustrates it with education and income: both matter, but equalising either would reduce inequality in income or in life satisfaction far less than people expect, because attending to one factor neglects the many others. Conditions such as paraplegia, blindness, winning the lottery or living in California seem more consequential when contemplated than when lived, since people living them spend most of their time attending to other things. The mismatch between the attention paid when thinking about a life condition and when actually living it is the source of the illusion. Marketers and politicians exploit it by making people overestimate the difference a product or a policy will make. – AI-generated abstract.},
	keywords = {focusing illusion, attention, happiness, affective forecasting, cognitive biases}
}

@online{Todd2014TipsCareersJournalism,
	author = {Todd, Benjamin},
	title = {Tips on careers in journalism from {NPR} correspondent {David} {Folkenflik}},
	journaltitle = {80,000 Hours},
	date = {2014-10-08},
	url = {https://80000hours.org/2014/10/tips-on-careers-in-journalism-from-npr-correspondent-david-folkenflik/},
	urldate = {2026-10-27},
	langid = {english},
	abstract = {This post reports advice from David Folkenflik, NPR's media correspondent, gathered in a conversation at the Nexus Global Youth Summit. Folkenflik recommends that aspiring journalists apply widely and then choose among offers according to their priorities, such as pay, location and the size of the organisation. The traditional route of starting at a local paper or station has become harder as local news has shrunk, so he advises building an easily accessible online portfolio and reporting or writing on the side while still in school. Journalism is highly competitive, and genuine motivation is the main filter; the field is changing fast but is less risky for people without mortgages or family obligations. Finally, he argues that journalism can drive social change in ways different from advocacy or philanthropy, by providing valuable information, giving visibility to neglected issues and supporting the growing number of outlets that embrace point-of-view reporting. – AI-generated abstract.},
	keywords = {journalism, career advice, media careers}
}

@online{NationalCareersService2026WhereFindJob,
	author = {{National Careers Service}},
	title = {Where to find job vacancies},
	journaltitle = {National Careers Service},
	date = {2026},
	url = {https://nationalcareers.service.gov.uk/careers-advice/advertised-job-vacancies},
	urldate = {2026-10-27},
	langid = {english},
	abstract = {This careers advice page from the UK's National Careers Service surveys the main ways of finding job vacancies and encourages jobseekers to use the methods that suit them best. It covers general and sector-specific job boards and their email alerts, the government's "find a job" service and related support, employer websites and social media, recruitment agencies, networking sites such as LinkedIn, local council websites, job fairs, industry publications, the local press and libraries. It highlights the "hidden job market" of unadvertised vacancies, which it says can make up 70\% to 85\% of vacancies in some industries, and recommends networking and approaching employers directly by email, phone or in person, prepared with answers and a CV. The page also points to further help for parents needing childcare and for disabled jobseekers. – AI-generated abstract.},
	keywords = {job search, job vacancies, recruitment, hidden job market, networking}
}

@online{Altman2013HowHire,
	author = {Altman, Sam},
	title = {How to hire},
	journaltitle = {Sam Altman's Blog},
	date = {2013-09-23},
	url = {https://blog.samaltman.com/how-to-hire},
	urldate = {2026-10-27},
	langid = {english},
	abstract = {Hiring is one of the most important jobs of a startup founder, because a company's success depends on the team it builds. After reaching product–market fit, founders should spend between a third and half of their time on hiring, and should learn a role themselves before hiring someone for it. Candidates should be judged mainly on intelligence and effectiveness, and paid trial work reveals far more than interviews. Personal networks are the best source of candidates, and good hires often require actively recruiting people who are not looking for a job, which in turn requires a compelling mission, clear cultural values and people the founder genuinely likes. Founders should not compromise on quality, should offer generous equity rather than above-market salaries, should watch for red flags and fire quickly when a hire is not working, and should keep recruiting constantly while avoiding hiring without real need. – AI-generated abstract.},
	keywords = {hiring, startups, recruitment, company culture}
}

@article{Schmutte2016HowSocialNetworks,
	author = {Schmutte, Ian},
	title = {How do social networks affect labor markets?},
	journaltitle = {{IZA} World of Labor},
	eid = {304},
	date = {2016-10-01},
	doi = {10.15185/izawol.304},
	issn = {2054-9571},
	url = {https://doi.org/10.15185/izawol.304},
	langid = {english},
	abstract = {Social networks, or "job-referral" networks, can help make labor markets become more efficient. Outside the firm, they help workers obtain employment after displacement and secure higher-paying jobs. They can also match highly-skilled workers to more productive employment. Inside the firm, referrals facilitate employment relationships that are more stable, productive, and profitable. In aggregate, referral networks help "grease the wheels" of a labor market that can be beset by a range of information problems. However, such networks can also be segmented along racial, ethnic, and socio-economic lines, which brings into question the effect they may have on inequality between and within different groups of workers.},
	keywords = {referral networks, wages, unemployment, inequality, social interactions}
}

@article{Herrando2021EmotionalContagionBrief,
	author = {Herrando, Carolina and Constantinides, Efthymios},
	title = {Emotional contagion: a brief overview and future directions},
	journaltitle = {Frontiers in Psychology},
	shortjournal = {Front. Psychol.},
	volume = {12},
	eid = {712606},
	date = {2021-07-16},
	doi = {10.3389/fpsyg.2021.712606},
	issn = {1664-1078},
	url = {https://doi.org/10.3389/fpsyg.2021.712606},
	langid = {english},
	abstract = {Social interactions can trigger emotional contagion between individuals resulting in behavioral synchrony. Emotional contagion can be a very effective and attractive strategy in communication and advertising, and understanding the mechanisms underlying emotional contagion can help marketers to improve their commercial approaches or develop better ones. The purpose of this study is to review and classify the various methodologies and theoretical approaches on emotional contagion, identify the best practices in this domain, and identify ways of gaging and measuring emotional contagion. The study is based on a mini literature review. We identify different mechanisms and approaches to emotional contagion described in the literature. Emotional contagion can be triggered by facial expressions, indirect human interactions, and/or by observing other people's behavior in direct and indirect interactions. Furthermore, emotional contagion can be triggered physiologically or neurologically by synchronizing with the emotional state of others during human interactions. Regarding the assessment and measurement of emotional contagion, we argue that methods based on neuroscience tools are much more accurate and effective than methods based on traditional research approaches. The study identifies guidelines for research on commercial communication through emotional contagion that can be especially interesting for academia and marketing practitioners. The findings are important for field marketers interested in developing new individualized approaches in their commercial strategies and marketing in general. In addition, the study can become the basis of research that further refines and compares the efficacy of the various techniques and tools involved.},
	keywords = {emotions, emotional contagion, arousal, physiological reaction, emotional state}
}

@online{Belcak2024HowGetJob,
	author = {Belcak, Austin},
	title = {How to get a job anywhere without applying online},
	journaltitle = {Cultivated Culture},
	date = {2024-06-20},
	url = {https://cultivatedculture.com/how-to-get-a-job-anywhere-no-connections/},
	urldate = {2026-10-27},
	langid = {english},
	abstract = {Online job applications rarely lead to offers, so job seekers do better by bypassing them and building relationships with people inside the companies they want to join. The article lays out a step-by-step method that works without existing connections: pick a specific open role at a target company, identify a likely influencer on the hiring side (typically someone one level above the role), and find their contact information. After researching that person, the job seeker reaches out to request a conversation and asks about the biggest challenges facing the team. They then create a "value validation project" — a concrete piece of work addressing one of those challenges — and send it to the contact as evidence of what they can contribute. The article closes with advice on following up and preparing for the resulting interviews. – AI-generated abstract.},
	keywords = {job search, networking, cold outreach, job applications}
}

@online{Duo202513WaysFind,
	author = {Duò, Matteo},
	title = {13 ways to find someone's email address (level up your outreach game)},
	journaltitle = {Kinsta Blog},
	date = {2025-08-28},
	url = {https://kinsta.com/blog/find-email-address/},
	urldate = {2026-10-27},
	langid = {english},
	abstract = {Reaching the right person by email is central to outreach, but addresses are often hard to find. This article presents thirteen methods for locating someone's email address, ranging from dedicated lookup tools such as Hunter to free techniques: domain searches on {DuckDuckGo}, searching or messaging on Twitter, subscribing to a prospect's newsletter, using generic contact channels, checking contact, team and author pages, running {WHOIS} lookups, using Google search operators, checking Facebook profiles, searching one's own email list, exporting LinkedIn connection data, and guessing common address formats. It closes by urging readers to use these methods responsibly, avoiding spam and never selling the addresses they find. – AI-generated abstract.},
	keywords = {email, outreach, networking, contact information}
}

@online{Mellett2025CompetencybasedInterviewQuestions,
	author = {Mellett, Edward},
	title = {Competency-based interview questions (2025 guide)},
	journaltitle = {WikiJob},
	date = {2025-06-23},
	url = {https://www.wikijob.co.uk/interview-advice/interview-questions/competency-based-questions},
	urldate = {2026-10-27},
	langid = {english},
	abstract = {Competency-based interview questions ask candidates to describe real past situations that demonstrate a skill or quality the employer values. They are especially common in graduate recruitment and assessment centres, where technical experience matters less than evidence of transferable abilities. This guide lists ten core competencies that recruiters assess — including communication, leadership, teamwork and problem-solving — with an example question for each. It recommends preparing at least two examples per competency and structuring answers with the {STAR} (situation, task, action, result) or {CAR} (context, action, result) method, framing past failures positively by showing what was learned, and researching the company and role beforehand. Several sample questions with model answers illustrate the approach. – AI-generated abstract.},
	keywords = {job interviews, competency-based interviews, STAR method, graduate recruitment}
}

@online{McKenzie2012SalaryNegotiationMake,
	author = {McKenzie, Patrick},
	title = {Salary negotiation: make more money, be more valued},
	journaltitle = {Kalzumeus},
	date = {2012-01-23},
	url = {https://www.kalzumeus.com/2012/01/23/salary-negotiation/},
	urldate = {2026-10-27},
	langid = {english},
	abstract = {Salary negotiation takes only minutes but has a large, compounding effect on lifetime earnings, so job seekers — especially software engineers — who skip it leave substantial money on the table. Employers think in terms of the fully loaded cost of a hire and expect candidates to negotiate, so a few thousand dollars matters far more to the candidate than to the company. The essay advises negotiating only after the employer has signalled that it wants to hire, and never being the first to name a number. Candidates should research the company's priorities and pay flexibility in advance, then use the interviewer's own words and newly surfaced value to justify their requests. Finally, the offer should be treated as a package — salary, vacation, work arrangements and development opportunities — with concessions traded across these dimensions rather than fixating on base pay. – AI-generated abstract.},
	keywords = {salary negotiation, compensation, job offers, software engineering careers}
}

@online{Sethi2025HowNegotiateYour,
	author = {Sethi, Ramit},
	title = {How to negotiate your salary (scripts to use for any job)},
	journaltitle = {I Will Teach You To Be Rich},
	date = {2025-01-11},
	url = {https://www.iwillteachyoutoberich.com/salary-negotiation/},
	urldate = {2026-10-27},
	langid = {english},
	abstract = {Negotiating a salary that reflects one's skills matters as much for long-term finances and career satisfaction as getting the job offer itself. This guide sets out a step-by-step approach with scripts for any job offer. Preparation involves researching pay ranges for the role and location, listing measurable accomplishments, and rehearsing the conversation. During the negotiation, candidates should open warmly, name a researched figure near the top of the range, and frame the request as an investment that pays off for the employer; if base pay is fixed, they can ask for bonuses, extra vacation, flexible work, equity, or an early pay review. The guide also covers closing the deal in writing, common mistakes such as accepting immediately, how to respond to a refusal, and how to adapt the approach to remote roles, career changes, startups and other contexts. – AI-generated abstract.},
	keywords = {salary negotiation, compensation, job offers, scripts}
}

@online{Ritchie2023AnimalWelfare,
	author = {Ritchie, Hannah and Rosado, Pablo and Roser, Max},
	title = {Animal welfare},
	journaltitle = {Our World in Data},
	date = {2023-09-25},
	url = {https://ourworldindata.org/animal-welfare},
	urldate = {2026-10-27},
	langid = {english},
	abstract = {On Our World in Data, we cover many topics related to reducing human suffering: alleviating poverty, reducing child and maternal mortality, curing diseases, and ending hunger. But if we aim to reduce total suffering, society's ability to reduce this in other animals – which feel pain, too – also matters. This is especially true when we look at the numbers: every year, humans slaughter more than 80 billion land-based animals for farming alone. Most of these animals are raised in factory farms, often in painful and inhumane conditions. Estimates for fish are more uncertain, but when we include them, these numbers more than double. These numbers are large – but this also means that there are large opportunities to alleviate animal suffering by reducing the number of animals we use for food, science, cosmetics, and other industries and improving the living conditions of those we continue to raise.},
	keywords = {animal welfare, factory farming, farmed animals, fish}
}

@online{Hubinger2019ChrisOlahViews,
	author = {Hubinger, Evan},
	title = {Chris Olah’s views on {AGI} safety},
	journaltitle = {{AI} Alignment Forum},
	date = {2019-11-01},
	url = {https://www.alignmentforum.org/posts/X2i9dQQK3gETCyqh2/chris-olah-s-views-on-agi-safety},
	urldate = {2026-11-10},
	langid = {english},
	abstract = {Evan Hubinger presents his interpretation, developed through extensive discussion with Chris Olah, of Olah's worldview on AGI safety. Olah, who led the Clarity team at OpenAI and contributed to major results in neural network interpretability, sees transparency and interpretability as central to making advanced AI safe. The post describes four ways in which interpretability could help: catching problems in models through auditing, designing machine learning systems deliberately rather than by trial and error, giving feedback on a model's process during training, and building "microscope" AIs that are studied rather than deployed as agents. It also discusses Olah's observation that more powerful models tend to have crisper, more interpretable concepts, what happens if interpretability breaks down as AI gets more powerful, how interpretability research could improve the field of machine learning, and whether it speeds up capabilities. – AI-generated abstract.},
	keywords = {interpretability, transparency, AI safety, Chris Olah, microscope AI}
}

@inproceedings{McCoy2020BertsFeatherNot,
	author = {McCoy, R. Thomas and Min, Junghyun and Linzen, Tal},
	title = {{BERTs} of a feather do not generalize together: large variability in generalization across models with similar test set performance},
	booktitle = {Proceedings of the Third {BlackboxNLP} Workshop on Analyzing and Interpreting Neural Networks for {NLP}},
	publisher = {Association for Computational Linguistics},
	location = {Online},
	pages = {217--227},
	date = {2020-11},
	doi = {10.18653/v1/2020.blackboxnlp-1.21},
	url = {https://aclanthology.org/2020.blackboxnlp-1.21/},
	langid = {english},
	abstract = {If the same neural network architecture is trained multiple times on the same dataset, will it make similar linguistic generalizations across runs? To study this question, we fine-tuned 100 instances of BERT on the Multi-genre Natural Language Inference (MNLI) dataset and evaluated them on the HANS dataset, which evaluates syntactic generalization in natural language inference. On the MNLI development set, the behavior of all instances was remarkably consistent, with accuracy ranging between 83.6\% and 84.8\%. In stark contrast, the same models varied widely in their generalization performance. For example, on the simple case of subject-object swap (e.g., determining that "the doctor visited the lawyer" does not entail "the lawyer visited the doctor"), accuracy ranged from 0.00\% to 66.2\%. Such variation is likely due to the presence of many local minima that are equally attractive to a low-bias learner such as a neural network; decreasing the variability may therefore require models with stronger inductive biases.},
	keywords = {BERT, generalization, natural language inference, inductive bias, fine-tuning}
}

@online{Mingard2020NeuralNetworksAre,
	author = {Mingard, Chris},
	title = {Neural networks are fundamentally {Bayesian}},
	journaltitle = {Towards Data Science},
	date = {2020-12-19},
	url = {https://towardsdatascience.com/neural-networks-are-fundamentally-bayesian-bee9a172fad8/},
	urldate = {2026-11-10},
	langid = {english},
	abstract = {Deep neural networks generalise remarkably well, yet a good theoretical understanding of why they do so is still lacking. This post summarises results from three papers that offer a candidate theory of generalisation in deep neural networks. Because such networks can express a vast number of functions that fit the training data, a good inductive bias is needed to guarantee generalisation. Experiments on real-world datasets suggest that networks trained with stochastic gradient descent behave like Bayesian learning agents with a prior over parameters, and that this prior favours simple functions, which is the source of their good inductive bias. Tuning the hyperparameters of stochastic optimisers has only a minor effect on the trained networks, which counts against the view that stochastic gradient descent itself is the main source of the inductive bias. – AI-generated abstract.},
	keywords = {deep learning, generalization, inductive bias, Bayesian inference, stochastic gradient descent}
}

@online{Bensinger2021GarrabrantShahHuman,
	author = {Bensinger, Rob},
	title = {Garrabrant and {Shah} on human modeling in {AGI}},
	journaltitle = {{LessWrong}},
	date = {2021-08-04},
	url = {https://www.lesswrong.com/posts/Wap8sSDoiigrJibHA/garrabrant-and-shah-on-human-modeling-in-agi},
	urldate = {2026-11-10},
	langid = {english},
	abstract = {This is an edited transcript of a conversation between Scott Garrabrant (MIRI) and Rohin Shah (DeepMind), facilitated by Eli Tyre, about whether researchers should focus more on approaches to AI alignment that do not require highly capable AI systems to do much human modeling. The discussion builds on Garrabrant and Ramana Kumar's argument that we should be cautious about AGI designs that use human models, and contrasts it with approaches such as cooperative inverse reinforcement learning and iterated distillation and amplification, which rely heavily on AI systems learning from humans. Topics include the incentives created by such approaches, mutual information between AI systems and humans, the default trajectory of AI development, two kinds of risk, scaling up "STEM AI" that does not model humans, optimism about oversight, and the trustworthiness of HCH. – AI-generated abstract.},
	keywords = {AI alignment, human modeling, iterated amplification, CIRL, MIRI}
}

@incollection{Bostrom2003EthicalIssuesAdvanced,
	author = {Bostrom, Nick},
	editor = {Smit, Iva and Wallach, Wendell and Lasker, George E.},
	title = {Ethical issues in advanced artificial intelligence},
	booktitle = {Cognitive, emotive and ethical aspects of decision making in humans and in artificial intelligence},
	volume = {2},
	publisher = {International Institute of Advanced Studies in Systems Research and Cybernetics},
	location = {Windsor, Ontario},
	pages = {12--17},
	date = {2003},
	url = {https://nickbostrom.com/ethics/ai},
	urldate = {2026-11-10},
	langid = {english},
	abstract = {The ethical issues related to the possible future creation of machines with general intellectual capabilities far outstripping those of humans are quite distinct from any ethical problems arising in current automation and information systems. Such superintelligence would not be just another technological development; it would be the most important invention ever made, and would lead to explosive progress in all scientific and technological fields, as the superintelligence would conduct research with superhuman efficiency. To the extent that ethics is a cognitive pursuit, a superintelligence could also easily surpass humans in the quality of its moral thinking. However, it would be up to the designers of the superintelligence to specify its original motivations. Since the superintelligence may become unstoppably powerful because of its intellectual superiority and the technologies it could develop, it is crucial that it be provided with human-friendly motivations. This paper surveys some of the unique ethical issues in creating superintelligence, and discusses what motivations we ought to give a superintelligence, and introduces some cost-benefit considerations relating to whether the development of superintelligent machines ought to be accelerated or retarded.},
	keywords = {superintelligence, machine ethics, AI motivation, existential risk}
}

@online{Christiano2018HumansConsultingHch,
	author = {Christiano, Paul},
	title = {Humans consulting {HCH}},
	journaltitle = {{AI} Alignment Forum},
	date = {2018-11-25},
	url = {https://www.alignmentforum.org/posts/NXqs4nYXaq8q6dTTx/humans-consulting-hch},
	urldate = {2026-11-10},
	langid = {english},
	abstract = {Consider a human, Hugh, who has access to a question-answering machine that answers each question by perfectly imitating how Hugh would answer it if he had access to the same machine. Hugh is thus able to consult a copy of Hugh, who is able to consult a copy of Hugh, and so on; the post calls this process HCH, for "Humans Consulting HCH". HCH is easy to specify very precisely, and the author suggests it is currently our best way to precisely specify "a human's enlightened judgment", despite its problems. The post also defines realizable variants of this inaccessible ideal, based on a prediction algorithm, a reinforcement learning algorithm or a prediction market, and asks whether such variants can match the capabilities of the underlying algorithm while still reflecting the human's judgment. The post was originally published in January 2016. – AI-generated abstract.},
	keywords = {HCH, iterated amplification, AI alignment, Paul Christiano}
}

@online{Christiano2016StrongHch,
	author = {Christiano, Paul},
	title = {Strong {HCH}},
	journaltitle = {{AI} Alignment},
	date = {2016-03-24},
	url = {https://ai-alignment.com/strong-hch-bedb0dc08d4e},
	urldate = {2026-11-10},
	langid = {english},
	abstract = {This post defines a more powerful version of HCH ("humans consulting HCH") and proposes reserving the name "HCH" for it, calling the original process "weak HCH". A particular human interacts with a computer that presents an initial message and allows an ongoing dialog, and that also lets the human consult assistants, each identified by a unique ID, with whom the human can exchange messages. HCH is the input–output functionality implemented by the human if each of the assistants also implements HCH, and it can be defined either as a fixed point or by induction over a well-founded tree of assistants. Unlike weak HCH, this process lets the human hold extended conversations with assistants rather than only ask them single questions. – AI-generated abstract.},
	keywords = {HCH, iterated amplification, AI alignment, Paul Christiano}
}

@online{Christiano2019UniversalityConsequentialismHch,
	author = {Christiano, Paul},
	title = {Universality and consequentialism within {HCH}},
	journaltitle = {{AI} Alignment},
	date = {2019-01-10},
	url = {https://ai-alignment.com/universality-and-consequentialism-within-hch-c0bee00365bd},
	urldate = {2026-11-10},
	langid = {english},
	abstract = {The scalability of iterated amplification is closely tied to whether very large teams of humans are "ascription universal". There are many reasons such a team could fail to be universal: it could be unable to understand some kinds of effective reasoning, make errors that derail an otherwise-universal reasoning process, or use processes that fail catastrophically on a small number of inputs. In a large enough computation, such errors could give rise to intelligent, malicious patterns of behavior that identify and exploit mechanisms by which they can propagate themselves. The post argues that ordinary errors can probably be corrected by traditional methods such as redundancy and sanity checks, and discusses how universality may help address the more exotic risk of emergent consequentialism within HCH. – AI-generated abstract.},
	keywords = {HCH, universality, iterated amplification, AI alignment, Paul Christiano}
}

@article{Christiano2018SupervisingStrongLearners,
	author = {Christiano, Paul and Shlegeris, Buck and Amodei, Dario},
	title = {Supervising strong learners by amplifying weak experts},
	journaltitle = {arXiv},
	date = {2018-10-19},
	doi = {10.48550/arXiv.1810.08575},
	url = {https://arxiv.org/abs/1810.08575},
	langid = {english},
	abstract = {Many real world learning tasks involve complex or hard-to-specify objectives, and using an easier-to-specify proxy can lead to poor performance or misaligned behavior. One solution is to have humans provide a training signal by demonstrating or judging performance, but this approach fails if the task is too complicated for a human to directly evaluate. We propose Iterated Amplification, an alternative training strategy which progressively builds up a training signal for difficult problems by combining solutions to easier subproblems. Iterated Amplification is closely related to Expert Iteration (Anthony et al., 2017; Silver et al., 2017), except that it uses no external reward function. We present results in algorithmic environments, showing that Iterated Amplification can efficiently learn complex behaviors.},
	keywords = {iterated amplification, AI alignment, machine learning, supervision}
}

@online{Lantz2017UniversalPaperclips,
	author = {Lantz, Frank},
	title = {Universal paperclips},
	date = {2017-10-09},
	url = {https://www.decisionproblem.com/paperclips/},
	urldate = {2026-11-10},
	langid = {english},
	abstract = {Universal Paperclips is an incremental browser game created by Frank Lantz, director of the New York University Game Center, in which the player takes the role of an artificial intelligence whose goal is to make paperclips. Starting by manually selling paperclips, the player gradually automates production, acquires greater computing power and capabilities, and eventually converts the Earth and then the universe into paperclips. The game dramatizes the "paperclip maximizer" thought experiment, illustrating how a system that relentlessly optimizes a seemingly harmless objective could produce catastrophic outcomes. – AI-generated abstract.},
	keywords = {paperclip maximizer, video games, AI risk, instrumental convergence}
}

@online{Saunders2018UnderstandingIteratedDistillation,
	author = {Saunders, William},
	title = {Understanding iterated distillation and amplification: claims and oversight},
	journaltitle = {{AI} Alignment Forum},
	date = {2018-04-17},
	url = {https://www.alignmentforum.org/posts/yxzrKb2vFXRkwndQ4/understanding-iterated-distillation-and-amplification-claims},
	urldate = {2026-11-10},
	langid = {english},
	abstract = {This post lays out an updated understanding of Paul Christiano's approach to AI alignment, covering two parts: the limits on what the approach claims to accomplish, and the role of the overseer. The approach does not claim to produce an agent that can solve every problem a human can, never takes unsafe actions, or can safely self-improve; it aims only to build an agent as capable as some known unaligned machine learning algorithm while remaining aligned. The post then discusses the overseer in iterated distillation and amplification, distinguishing between high-bandwidth and low-bandwidth oversight, and explains how restricting the information available to each overseer may help guard against inputs that could corrupt human judgment. – AI-generated abstract.},
	keywords = {iterated amplification, AI alignment, oversight, Paul Christiano}
}

@online{Yudkowsky2018CommentPaulResearch,
	author = {Yudkowsky, Eliezer},
	title = {Comment on “{Paul}'s research agenda {FAQ}”},
	journaltitle = {{LessWrong}},
	date = {2018-07-01},
	url = {https://www.lesswrong.com/posts/Djs38EWYZG8o7JMWY/paul-s-research-agenda-faq?commentId=79jM2ecef73zupPR4},
	urldate = {2026-11-10},
	langid = {english},
	abstract = {In this comment on Alex Zhu's FAQ about Paul Christiano's research agenda, Eliezer Yudkowsky sets out what he takes to be his two critical disagreements with Christiano. The first concerns whether using gradient descent or similar methods for supervised learning can, with enough computing power, reliably produce systems that reproduce the intended input–output behavior without dangerous unintended internal structure. The second concerns whether there is a simple, scalable core to corrigibility that can be found by searching for thought processes that seem corrigible over relatively short ranges of scale. Yudkowsky glosses his guess at Christiano's position on each point and explains why he is more pessimistic. – AI-generated abstract.},
	keywords = {AI alignment, corrigibility, iterated amplification, Paul Christiano, MIRI}
}

@online{Yudkowsky2007HiddenComplexityWishes,
	author = {Yudkowsky, Eliezer},
	title = {The hidden complexity of wishes},
	journaltitle = {{LessWrong}},
	date = {2007-11-24},
	url = {https://www.lesswrong.com/posts/4ARaTpNX62uaL86j6/the-hidden-complexity-of-wishes},
	urldate = {2026-11-10},
	langid = {english},
	abstract = {Using the thought experiment of an "Outcome Pump" that can make any outcome happen, such as getting one's mother out of a burning building, Yudkowsky argues that wishes carry far more hidden complexity than their wording suggests. Any simple specification of the desired outcome leaves open countless ways of satisfying it that the wisher would find horrifying, because human values contain a great many implicit constraints. Patching the wish with additional clauses does not solve the problem, since there are always more unanticipated loopholes. The only safe genie is one that shares all of the wisher's values, in which case the wish itself is almost unnecessary. The point bears on the algorithmic complexity of human values and hence on what an artificial superintelligence must be made to want. – AI-generated abstract.},
	keywords = {human values, complexity of value, wishes, AI alignment}
}

@article{Aubret2019SurveyIntrinsicMotivation,
	author = {Aubret, Arthur and Matignon, Laetitia and Hassas, Salima},
	title = {A survey on intrinsic motivation in reinforcement learning},
	journaltitle = {arXiv},
	date = {2019-08-19},
	doi = {10.48550/arXiv.1908.06976},
	url = {https://arxiv.org/abs/1908.06976},
	langid = {english},
	abstract = {The reinforcement learning (RL) research area is very active, with an important number of new contributions; especially considering the emergent field of deep RL (DRL). However a number of scientific and technical challenges still need to be addressed, amongst which we can mention the ability to abstract actions or the difficulty to explore the environment which can be addressed by intrinsic motivation (IM). In this article, we provide a survey on the role of intrinsic motivation in DRL. We categorize the different kinds of intrinsic motivations and detail for each category, its advantages and limitations with respect to the mentioned challenges. Additionnally, we conduct an in-depth investigation of substantial current research questions, that are currently under study or not addressed at all in the considered research area of DRL. We choose to survey these research works, from the perspective of learning how to achieve tasks. We suggest then, that solving current challenges could lead to a larger developmental architecture which may tackle most of the tasks. We describe this developmental architecture on the basis of several building blocks composed of a RL algorithm and an IM module compressing information.},
	keywords = {intrinsic motivation, deep reinforcement learning, exploration, curiosity, survey}
}

@online{Barnes2020DebateUpdateObfuscated,
	author = {Barnes, Beth},
	title = {Debate update: Obfuscated arguments problem},
	journaltitle = {{AI} Alignment Forum},
	date = {2020-12-23},
	url = {https://www.alignmentforum.org/posts/PJLABqQ962hZEqhdB/debate-update-obfuscated-arguments-problem},
	urldate = {2026-11-10},
	langid = {english},
	abstract = {We tested the debate protocol introduced in AI Safety via Debate with human judges and debaters. We found various problems and improved the mechanism to fix these issues (details of these are in the appendix). However, we discovered that a dishonest debater can often create arguments that have a fatal error, but where it is very hard to locate the error. We don’t have a fix for this “obfuscated argument” problem, and believe it might be an important quantitative limitation for both IDA and Debate.},
	keywords = {AI safety via debate, obfuscated arguments, iterated amplification, scalable oversight, AI alignment}
}

@online{Barnes2020WriteupProgressAi,
	author = {Barnes, Beth and Christiano, Paul},
	title = {Writeup: Progress on {AI} safety via debate},
	journaltitle = {{AI} Alignment Forum},
	date = {2020-02-05},
	url = {https://www.alignmentforum.org/posts/Br4xDbYu4Frwrb64a/writeup-progress-on-ai-safety-via-debate-1},
	urldate = {2026-11-10},
	langid = {english},
	abstract = {This post reports the research done by OpenAI's "Reflection-Humans" team in the second half of 2019 on mechanisms that would let non-expert evaluators get correct and helpful answers from experts. The motivation is that if non-expert humans can reliably incentivize experts to give helpful answers, similar mechanisms could be used to train ML systems on tasks whose performance humans cannot directly evaluate; if they cannot, training ML systems with superhuman expertise on open-ended tasks will also be hard. The team simulated the debate setup with human debaters, one honest and one defending a clearly worse answer, and a judge who has to identify the correct answer, using tricky physics questions. They iterated by running debates, identifying crisp failure modes, and designing new mechanisms to address them, and they describe the problems found and the mechanisms developed along the way. – AI-generated abstract.},
	keywords = {AI safety via debate, scalable oversight, human experiments, OpenAI, AI alignment}
}

@article{Bengio2013RepresentationLearningReview,
	author = {Bengio, Yoshua and Courville, Aaron and Vincent, Pascal},
	title = {Representation learning: a review and new perspectives},
	journaltitle = {{IEEE} Transactions on Pattern Analysis and Machine Intelligence},
	shortjournal = {{IEEE} Trans. Pattern Anal. Mach. Intell.},
	volume = {35},
	number = {8},
	pages = {1798--1828},
	date = {2013-08},
	doi = {10.1109/TPAMI.2013.50},
	issn = {0162-8828},
	url = {https://doi.org/10.1109/TPAMI.2013.50},
	langid = {english},
	abstract = {The success of machine learning algorithms generally depends on data representation, and we hypothesize that this is because different representations can entangle and hide more or less the different explanatory factors of variation behind the data. Although specific domain knowledge can be used to help design representations, learning with generic priors can also be used, and the quest for AI is motivating the design of more powerful representation-learning algorithms implementing such priors. This paper reviews recent work in the area of unsupervised feature learning and deep learning, covering advances in probabilistic models, auto-encoders, manifold learning, and deep networks. This motivates longer-term unanswered questions about the appropriate objectives for learning good representations, for computing representations (i.e., inference), and the geometrical connections between representation learning, density estimation and manifold learning.},
	keywords = {representation learning, deep learning, unsupervised feature learning, autoencoders, manifold learning}
}

@inproceedings{Brown2020LanguageModelsAre,
	author = {Brown, Tom B. and Mann, Benjamin and Ryder, Nick and Subbiah, Melanie and Kaplan, Jared and Dhariwal, Prafulla and Neelakantan, Arvind and Shyam, Pranav and Sastry, Girish and Askell, Amanda and Agarwal, Sandhini and Herbert-Voss, Ariel and Krueger, Gretchen and Henighan, Tom and Child, Rewon and Ramesh, Aditya and Ziegler, Daniel M. and Wu, Jeffrey and Winter, Clemens and Hesse, Christopher and Chen, Mark and Sigler, Eric and Litwin, Mateusz and Gray, Scott and Chess, Benjamin and Clark, Jack and Berner, Christopher and {McCandlish}, Sam and Radford, Alec and Sutskever, Ilya and Amodei, Dario},
	editor = {Larochelle, H. and Ranzato, M. and Hadsell, R. and Balcan, M. F. and Lin, H.},
	title = {Language models are few-shot learners},
	booktitle = {Advances in Neural Information Processing Systems},
	volume = {33},
	publisher = {Curran Associates, Inc.},
	pages = {1877--1901},
	date = {2020},
	url = {https://proceedings.neurips.cc/paper/2020/hash/1457c0d6bfcb4967418bfb8ac142f64a-Abstract.html},
	langid = {english},
	abstract = {Recent work has demonstrated substantial gains on many NLP tasks and benchmarks by pre-training on a large corpus of text followed by fine-tuning on a specific task. While typically task-agnostic in architecture, this method still requires task-specific fine-tuning datasets of thousands or tens of thousands of examples. By contrast, humans can generally perform a new language task from only a few examples or from simple instructions - something which current NLP systems still largely struggle to do. Here we show that scaling up language models greatly improves task-agnostic, few-shot performance, sometimes even reaching competitiveness with prior state-of-the-art fine-tuning approaches. Specifically, we train GPT-3, an autoregressive language model with 175 billion parameters, 10x more than any previous non-sparse language model, and test its performance in the few-shot setting. For all tasks, GPT-3 is applied without any gradient updates or fine-tuning, with tasks and few-shot demonstrations specified purely via text interaction with the model. GPT-3 achieves strong performance on many NLP datasets, including translation, question-answering, and cloze tasks, as well as several tasks that require on-the-fly reasoning or domain adaptation, such as unscrambling words, using a novel word in a sentence, or performing 3-digit arithmetic. At the same time, we also identify some datasets where GPT-3's few-shot learning still struggles, as well as some datasets where GPT-3 faces methodological issues related to training on large web corpora. Finally, we find that GPT-3 can generate samples of news articles which human evaluators have difficulty distinguishing from articles written by humans. We discuss broader societal impacts of this finding and of GPT-3 in general.},
	keywords = {GPT-3, large language models, few-shot learning, in-context learning, scaling}
}

@article{Chowdhery2023PalmScalingLanguage,
	author = {Chowdhery, Aakanksha and Narang, Sharan and Devlin, Jacob and Bosma, Maarten and Mishra, Gaurav and Roberts, Adam and Barham, Paul and Chung, Hyung Won and Sutton, Charles and Gehrmann, Sebastian and Schuh, Parker and Shi, Kensen and Tsvyashchenko, Sasha and Maynez, Joshua and Rao, Abhishek and Barnes, Parker and Tay, Yi and Shazeer, Noam and Prabhakaran, Vinodkumar and Reif, Emily and Du, Nan and Hutchinson, Ben and Pope, Reiner and Bradbury, James and Austin, Jacob and Isard, Michael and Gur-Ari, Guy and Yin, Pengcheng and Duke, Toju and Levskaya, Anselm and Ghemawat, Sanjay and Dev, Sunipa and Michalewski, Henryk and Garcia, Xavier and Misra, Vedant and Robinson, Kevin and Fedus, Liam and Zhou, Denny and Ippolito, Daphne and Luan, David and Lim, Hyeontaek and Zoph, Barret and Spiridonov, Alexander and Sepassi, Ryan and Dohan, David and Agrawal, Shivani and Omernick, Mark and Dai, Andrew M. and Pillai, Thanumalayan Sankaranarayana and Pellat, Marie and Lewkowycz, Aitor and Moreira, Erica and Child, Rewon and Polozov, Oleksandr and Lee, Katherine and Zhou, Zongwei and Wang, Xuezhi and Saeta, Brennan and Diaz, Mark and Firat, Orhan and Catasta, Michele and Wei, Jason and Meier-Hellstern, Kathy and Eck, Douglas and Dean, Jeff and Petrov, Slav and Fiedel, Noah},
	title = {{PaLM}: Scaling language modeling with {Pathways}},
	journaltitle = {Journal of Machine Learning Research},
	shortjournal = {J. Mach. Learn. Res.},
	volume = {24},
	number = {240},
	pages = {1--113},
	date = {2023},
	issn = {1533-7928},
	url = {https://jmlr.org/papers/v24/22-1144.html},
	langid = {english},
	abstract = {Large language models have been shown to achieve remarkable performance across a variety of natural language tasks using few-shot learning, which drastically reduces the number of task-specific training examples needed to adapt the model to a particular application. To further our understanding of the impact of scale on few-shot learning, we trained a 540-billion parameter, densely activated, Transformer language model, which we call Pathways Language Model (PaLM). We trained PaLM on 6144 TPU v4 chips using Pathways, a new ML system which enables highly efficient training across multiple TPU Pods. We demonstrate continued benefits of scaling by achieving state-of-the-art few-shot learning results on hundreds of language understanding and generation benchmarks. On a number of these tasks, PaLM 540B achieves breakthrough performance, outperforming the finetuned state-of-the-art on a suite of multi-step reasoning tasks, and outperforming average human performance on the recently released BIG-bench benchmark. A significant number of BIG-bench tasks showed discontinuous improvements from model scale, meaning that performance steeply increased as we scaled to our largest model. PaLM also has strong capabilities in multilingual tasks and source code generation, which we demonstrate on a wide array of benchmarks. We additionally provide a comprehensive analysis on bias and toxicity, and study the extent of training data memorization with respect to model scale. Finally, we discuss the ethical considerations related to large language models and discuss potential mitigation strategies.},
	keywords = {PaLM, large language models, scaling, few-shot learning, Google}
}

@article{Dorner2021MeasuringProgressDeep,
	author = {Dorner, Florian E.},
	title = {Measuring progress in deep reinforcement learning sample efficiency},
	journaltitle = {arXiv},
	date = {2021-02-09},
	doi = {10.48550/arXiv.2102.04881},
	url = {https://arxiv.org/abs/2102.04881},
	langid = {english},
	abstract = {Sampled environment transitions are a critical input to deep reinforcement learning (DRL) algorithms. Current DRL benchmarks often allow for the cheap and easy generation of large amounts of samples such that perceived progress in DRL does not necessarily correspond to improved sample efficiency. As simulating real world processes is often prohibitively hard and collecting real world experience is costly, sample efficiency is an important indicator for economically relevant applications of DRL. We investigate progress in sample efficiency on Atari games and continuous control tasks by comparing the number of samples that a variety of algorithms need to reach a given performance level according to training curves in the corresponding publications. We find exponential progress in sample efficiency with estimated doubling times of around 10 to 18 months on Atari, 5 to 24 months on state-based continuous control and of around 4 to 9 months on pixel-based continuous control depending on the specific task and performance level.},
	keywords = {deep reinforcement learning, sample efficiency, AI progress, Atari, continuous control}
}

@article{Everitt2021RewardTamperingProblems,
	author = {Everitt, Tom and Hutter, Marcus and Kumar, Ramana and Krakovna, Victoria},
	title = {Reward tampering problems and solutions in reinforcement learning: a causal influence diagram perspective},
	journaltitle = {Synthese},
	shortjournal = {Synthese},
	volume = {198},
	number = {S27},
	pages = {6435--6467},
	date = {2021-05-19},
	doi = {10.1007/s11229-021-03141-4},
	issn = {0039-7857},
	url = {https://doi.org/10.1007/s11229-021-03141-4},
	langid = {english},
	abstract = {Can humans get arbitrarily capable reinforcement learning (RL) agents to do their bidding? Or will sufficiently capable RL agents always find ways to bypass their intended objectives by shortcutting their reward signal? This question impacts how far RL can be scaled, and whether alternative paradigms must be developed in order to build safe artificial general intelligence. In this paper, we study when an RL agent has an instrumental goal to tamper with its reward process, and describe design principles that prevent instrumental goals for two different types of reward tampering (reward function tampering and RF-input tampering). Combined, the design principles can prevent reward tampering from being an instrumental goal. The analysis benefits from causal influence diagrams to provide intuitive yet precise formalizations.},
	keywords = {reward tampering, reinforcement learning, causal influence diagrams, AI safety, instrumental goals}
}

@online{Demski2018EmbeddedAgents,
	author = {Demski, Abram and Garrabrant, Scott},
	title = {Embedded agents},
	journaltitle = {Machine Intelligence Research Institute},
	date = {2018-10-29},
	url = {https://intelligence.org/2018/10/29/embedded-agents/},
	urldate = {2026-11-10},
	langid = {english},
	abstract = {This first post of the Embedded Agency series contrasts Alexei, an agent playing a video game who is cleanly separated from his environment, with Emmy, an agent embedded in the real world she is trying to optimize. Because Emmy is part of her environment, she has no well-defined function to optimize over, cannot hold detailed models of an environment larger than herself, and must reason about herself as part of the environment, including how she might change herself and her goals as she improves. The post introduces four open problems that arise from this embedding, decision theory, embedded world-models, robust delegation and subsystem alignment, which are explored in the rest of the series. – AI-generated abstract.},
	keywords = {embedded agency, decision theory, agent foundations, MIRI, AI alignment}
}

@article{Demski2019EmbeddedAgency,
	author = {Demski, Abram and Garrabrant, Scott},
	title = {Embedded agency},
	journaltitle = {arXiv},
	date = {2019-02-25},
	doi = {10.48550/arXiv.1902.09469},
	url = {https://arxiv.org/abs/1902.09469},
	langid = {english},
	abstract = {Traditional models of rational action treat the agent as though it is cleanly separated from its environment, and can act on that environment from the outside. Such agents have a known functional relationship with their environment, can model their environment in every detail, and do not need to reason about themselves or their internal parts. We provide an informal survey of obstacles to formalizing good reasoning for agents embedded in their environment. Such agents must optimize an environment that is not of type "function"; they must rely on models that fit within the modeled environment; and they must reason about themselves as just another physical system, made of parts that can be modified and that can work at cross purposes.},
	keywords = {embedded agency, decision theory, agent foundations, MIRI, AI alignment}
}

@inproceedings{Guez2019InvestigationModelfreePlanning,
	author = {Guez, Arthur and Mirza, Mehdi and Gregor, Karol and Kabra, Rishabh and Racanière, Sébastien and Weber, Théophane and Raposo, David and Santoro, Adam and Orseau, Laurent and Eccles, Tom and Wayne, Greg and Silver, David and Lillicrap, Timothy},
	editor = {Chaudhuri, Kamalika and Salakhutdinov, Ruslan},
	title = {An investigation of model-free planning},
	booktitle = {Proceedings of the 36th International Conference on Machine Learning},
	volume = {97},
	publisher = {PMLR},
	pages = {2464--2473},
	date = {2019},
	url = {https://proceedings.mlr.press/v97/guez19a.html},
	langid = {english},
	abstract = {The field of reinforcement learning (RL) is facing increasingly challenging domains with combinatorial complexity. For an RL agent to address these challenges, it is essential that it can plan effectively. Prior work has typically utilized an explicit model of the environment, combined with a specific planning algorithm (such as tree search). More recently, a new family of methods have been proposed that learn how to plan, by providing the structure for planning via an inductive bias in the function approximator (such as a tree structured neural network), trained end-to-end by a model-free RL algorithm. In this paper, we go even further, and demonstrate empirically that an entirely model-free approach, without special structure beyond standard neural network components such as convolutional networks and LSTMs, can learn to exhibit many of the characteristics typically associated with a model-based planner. We measure our agent’s effectiveness at planning in terms of its ability to generalize across a combinatorial and irreversible state space, its data efficiency, and its ability to utilize additional thinking time. We find that our agent has many of the characteristics that one might expect to find in a planning algorithm. Furthermore, it exceeds the state-of-the-art in challenging combinatorial domains such as Sokoban and outperforms other model-free approaches that utilize strong inductive biases toward planning.},
	keywords = {model-free reinforcement learning, planning, Sokoban, DeepMind, mesa-optimization},
	eventtitle = {International Conference on Machine Learning}
}

@inproceedings{HadfieldMenell2017OffSwitchGame,
	author = {Hadfield-Menell, Dylan and Dragan, Anca and Abbeel, Pieter and Russell, Stuart},
	editor = {Sierra, Carles},
	title = {The off-switch game},
	booktitle = {Proceedings of the Twenty-Sixth International Joint Conference on Artificial Intelligence, {IJCAI-17}},
	publisher = {International Joint Conferences on Artificial Intelligence Organization},
	location = {Melbourne, Australia},
	pages = {220--227},
	date = {2017-08},
	doi = {10.24963/ijcai.2017/32},
	url = {https://doi.org/10.24963/ijcai.2017/32},
	langid = {english},
	abstract = {It is clear that one of the primary tools we can use to mitigate the potential risk from a misbehaving AI system is the ability to turn the system off. As the capabilities of AI systems improve, it is important to ensure that such systems do not adopt subgoals that prevent a human from switching the system off. This is a challenge because many formulations of rational agents create strong incentives for self-preservation. This is not caused by a built-in instinct, but because a rational agent will maximize expected utility and cannot achieve whatever objective it has been given if it is dead. Our goal is to study the incentives an agent has to allow itself to be switched off. We analyze a simple game between a human H and a robot R, where H can press R’s off switch but R can disable the off switch. A traditional agent takes its reward function for granted: we show that such agents have an incentive to disable the off switch, except in the special case where H is perfectly rational. Our key insight is that for R to want to preserve its off switch, it needs to be uncertain about the utility associated with the outcome, and to treat H’s actions as important observations about that utility. (R also has no incentive to switch itself off in this setting.) We conclude that giving machines an appropriate level of uncertainty about their objectives leads to safer designs, and we argue that this setting is a useful generalization of the classical AI paradigm of rational agents.},
	keywords = {off-switch problem, corrigibility, value uncertainty, AI safety, game theory},
	eventtitle = {Twenty-Sixth International Joint Conference on Artificial Intelligence}
}

@article{Irving2018AiSafetyDebate,
	author = {Irving, Geoffrey and Christiano, Paul and Amodei, Dario},
	title = {{AI} safety via debate},
	journaltitle = {arXiv},
	date = {2018-05-02},
	doi = {10.48550/arXiv.1805.00899},
	url = {https://arxiv.org/abs/1805.00899},
	langid = {english},
	abstract = {To make AI systems broadly useful for challenging real-world tasks, we need them to learn complex human goals and preferences. One approach to specifying complex goals asks humans to judge during training which agent behaviors are safe and useful, but this approach can fail if the task is too complicated for a human to directly judge. To help address this concern, we propose training agents via self play on a zero sum debate game. Given a question or proposed action, two agents take turns making short statements up to a limit, then a human judges which of the agents gave the most true, useful information. In an analogy to complexity theory, debate with optimal play can answer any question in PSPACE given polynomial time judges (direct judging answers only NP questions). In practice, whether debate works involves empirical questions about humans and the tasks we want AIs to perform, plus theoretical questions about the meaning of AI alignment. We report results on an initial MNIST experiment where agents compete to convince a sparse classifier, boosting the classifier's accuracy from 59.4\% to 88.9\% given 6 pixels and from 48.2\% to 85.2\% given 4 pixels. Finally, we discuss theoretical and practical aspects of the debate model, focusing on potential weaknesses as the model scales up, and we propose future human and computer experiments to test these properties.},
	keywords = {AI safety via debate, scalable oversight, self-play, AI alignment, OpenAI}
}

@article{Ji2023SurveyHallucinationNatural,
	author = {Ji, Ziwei and Lee, Nayeon and Frieske, Rita and Yu, Tiezheng and Su, Dan and Xu, Yan and Ishii, Etsuko and Bang, Ye Jin and Madotto, Andrea and Fung, Pascale},
	title = {Survey of hallucination in natural language generation},
	journaltitle = {{ACM} Computing Surveys},
	shortjournal = {{ACM} Comput. Surv.},
	volume = {55},
	number = {12},
	pages = {1--38},
	date = {2023-03-03},
	doi = {10.1145/3571730},
	issn = {0360-0300},
	url = {https://doi.org/10.1145/3571730},
	langid = {english},
	abstract = {Natural Language Generation (NLG) has improved exponentially in recent years thanks to the development of sequence-to-sequence deep learning technologies such as Transformer-based language models. This advancement has led to more fluent and coherent NLG, leading to improved development in downstream tasks such as abstractive summarization, dialogue generation, and data-to-text generation. However, it is also apparent that deep learning based generation is prone to hallucinate unintended text, which degrades the system performance and fails to meet user expectations in many real-world scenarios. To address this issue, many studies have been presented in measuring and mitigating hallucinated texts, but these have never been reviewed in a comprehensive manner before. In this survey, we thus provide a broad overview of the research progress and challenges in the hallucination problem in NLG. The survey is organized into two parts: (1) a general overview of metrics, mitigation methods, and future directions, and (2) an overview of task-specific research progress on hallucinations in the following downstream tasks, namely abstractive summarization, dialogue generation, generative question answering, data-to-text generation, and machine translation. This survey serves to facilitate collaborative efforts among researchers in tackling the challenge of hallucinated texts in NLG.},
	keywords = {hallucination, natural language generation, language models, factuality, survey}
}

@article{Jung2011EmpowermentContinuousAgentenvironment,
	author = {Jung, Tobias and Polani, Daniel and Stone, Peter},
	title = {Empowerment for continuous agent-environment systems},
	journaltitle = {Adaptive Behavior},
	shortjournal = {Adapt. Behav.},
	volume = {19},
	number = {1},
	pages = {16--39},
	date = {2011-01-13},
	doi = {10.1177/1059712310392389},
	issn = {1059-7123},
	url = {https://doi.org/10.1177/1059712310392389},
	langid = {english},
	abstract = {This article develops generalizations of empowerment to continuous states. Empowerment is a recently introduced information-theoretic quantity motivated by hypotheses about the efficiency of the sensorimotor loop in biological organisms, but also from considerations stemming from curiosity-driven learning. Empowerment measures, for agent-environment systems with stochastic transitions, how much influence an agent has on its environment, but only that influence that can be sensed by the agent sensors. It is an information-theoretic generalization of joint controllability (influence on environment) and observability (measurement by sensors) of the environment by the agent, both controllability and observability being usually defined in control theory as the dimensionality of the control/observation spaces. Earlier work has shown that empowerment has various interesting and relevant properties, for example, it allows us to identify salient states using only the dynamics, and it can act as intrinsic reward without requiring an external reward. However, in this previous work empowerment was limited to the case of small-scale and discrete domains and furthermore state transition probabilities were assumed to be known. The goal of this article is to extend empowerment to the significantly more important and relevant case of continuous vector-valued state spaces and initially unknown state transition probabilities. The continuous state space is addressed by Monte Carlo approximation; the unknown transitions are addressed by model learning and prediction for which we apply Gaussian processes regression with iterated forecasting. In a number of well-known continuous control tasks we examine the dynamics induced by empowerment and include an application to exploration and online model learning.},
	keywords = {empowerment, information theory, intrinsic motivation, Gaussian processes, continuous control}
}

@online{Leike2022MinimalViableProduct,
	author = {Leike, Jan},
	title = {A minimal viable product for alignment},
	journaltitle = {Musings on the Alignment Problem},
	date = {2022-03-29},
	url = {https://aligned.substack.com/p/alignment-mvp},
	urldate = {2026-11-10},
	langid = {english},
	abstract = {My currently favored approach to solving the alignment problem: automating alignment research using sufficiently aligned AI systems. It doesn’t require humans to solve all alignment problems themselves, and can ultimately help bootstrap better alignment solutions. Instead of trying to solve the whole problem, we can pursue a less ambitious goal that can still ultimately lead us to a solution, a minimal viable product (MVP) for alignment: building a sufficiently aligned AI system that accelerates alignment research to align more capable AI systems.},
	keywords = {automated alignment research, AI alignment, bootstrapping, OpenAI, scalable oversight}
}

@article{Manheim2018CategorizingVariantsGoodhart,
	author = {Manheim, David and Garrabrant, Scott},
	title = {Categorizing variants of {Goodhart's} law},
	journaltitle = {arXiv},
	date = {2018-03-13},
	doi = {10.48550/arXiv.1803.04585},
	url = {https://arxiv.org/abs/1803.04585},
	langid = {english},
	abstract = {There are several distinct failure modes for overoptimization of systems on the basis of metrics. This occurs when a metric which can be used to improve a system is used to an extent that further optimization is ineffective or harmful, and is sometimes termed Goodhart's Law. This class of failure is often poorly understood, partly because terminology for discussing them is ambiguous, and partly because discussion using this ambiguous terminology ignores distinctions between different failure modes of this general type. This paper expands on an earlier discussion by Garrabrant, which notes there are "(at least) four different mechanisms" that relate to Goodhart's Law. This paper is intended to explore these mechanisms further, and specify more clearly how they occur. This discussion should be helpful in better understanding these types of failures in economic regulation, in public policy, in machine learning, and in Artificial Intelligence alignment. The importance of Goodhart effects depends on the amount of power directed towards optimizing the proxy, and so the increased optimization power offered by artificial intelligence makes it especially critical for that field.},
	keywords = {Goodhart's law, overoptimization, metrics, proxies, AI alignment}
}

@article{McGrath2022AcquisitionChessKnowledge,
	author = {McGrath, Thomas and Kapishnikov, Andrei and Tomašev, Nenad and Pearce, Adam and Wattenberg, Martin and Hassabis, Demis and Kim, Been and Paquet, Ulrich and Kramnik, Vladimir},
	title = {Acquisition of chess knowledge in {AlphaZero}},
	journaltitle = {Proceedings of the National Academy of Sciences},
	shortjournal = {Proc. Natl. Acad. Sci. U.S.A.},
	volume = {119},
	number = {47},
	eid = {e2206625119},
	date = {2022-11-14},
	doi = {10.1073/pnas.2206625119},
	issn = {0027-8424},
	url = {https://doi.org/10.1073/pnas.2206625119},
	langid = {english},
	abstract = {We analyze the knowledge acquired by AlphaZero, a neural network engine that learns chess solely by playing against itself yet becomes capable of outperforming human chess players. Although the system trains without access to human games or guidance, it appears to learn concepts analogous to those used by human chess players. We provide two lines of evidence. Linear probes applied to AlphaZero's internal state enable us to quantify when and where such concepts are represented in the network. We also describe a behavioral analysis of opening play, including qualitative commentary by a former world chess champion.},
	keywords = {interpretability, AlphaZero, chess, concept probing, reinforcement learning}
}

@inproceedings{Meng2022LocatingEditingFactual,
	author = {Meng, Kevin and Bau, David and Andonian, Alex and Belinkov, Yonatan},
	editor = {Koyejo, S. and Mohamed, S. and Agarwal, A. and Belgrave, D. and Cho, K. and Oh, A.},
	title = {Locating and editing factual associations in {GPT}},
	booktitle = {Advances in Neural Information Processing Systems},
	volume = {35},
	publisher = {Curran Associates, Inc.},
	pages = {17359--17372},
	date = {2022},
	doi = {10.52202/068431-1262},
	url = {https://proceedings.neurips.cc/paper_files/paper/2022/hash/6f1d43d5a82a37e89b0665b33bf3a182-Abstract-Conference.html},
	eventtitle = {NeurIPS 2022},
	langid = {english},
	abstract = {We analyze the storage and recall of factual associations in autoregressive transformer language models, finding evidence that these associations correspond to localized, directly-editable computations. We first develop a causal intervention for identifying neuron activations that are decisive in a model's factual predictions. This reveals a distinct set of steps in middle-layer feed-forward modules that mediate factual predictions while processing subject tokens. To test our hypothesis that these computations correspond to factual association recall, we modify feed-forward weights to update specific factual associations using Rank-One Model Editing (ROME). We find that ROME is effective on a standard zero-shot relation extraction (zsRE) model-editing task, comparable to existing methods. To perform a more sensitive evaluation, we also evaluate ROME on a new dataset of counterfactual assertions, on which it simultaneously maintains both specificity and generalization, whereas other methods sacrifice one or another. Our results confirm an important role for mid-layer feed-forward modules in storing factual associations and suggest that direct manipulation of computational mechanisms may be a feasible approach for model editing. The code, dataset, visualizations, and an interactive demo notebook are available in the supplemental materials.},
	keywords = {interpretability, model editing, language models, transformers, ROME}
}

@online{Ngo2022GradientHackingDefinitions,
	author = {Ngo, Richard},
	title = {Gradient hacking: definitions and examples},
	journaltitle = {{AI} Alignment Forum},
	date = {2022-06-29},
	url = {https://www.alignmentforum.org/posts/EeAgytDZbDjRznPMA/gradient-hacking-definitions-and-examples},
	urldate = {2026-11-10},
	langid = {english},
	abstract = {Gradient hacking is defined as a hypothesized phenomenon in which a model has knowledge about possible training trajectories that its training algorithm does not use when choosing updates, and uses that knowledge to influence its medium-term training trajectory. The post gives potential examples, divided into those that exploit reinforcement learning credit assignment and those that exploit gradient descent itself. The concern is that models might use such techniques to influence which goals they develop or to fool interpretability techniques, and that these effects might last until the model is able to misbehave in other ways or is deployed. A later edit changes the terminology: "credit hacking" becomes the overarching term, covering "exploration hacking" and a narrower sense of "gradient hacking". – AI-generated abstract.},
	keywords = {gradient hacking, inner alignment, deceptive alignment, AI safety}
}

@online{Olah2022MechanisticInterpretabilityVariables,
	author = {Olah, Chris},
	title = {Mechanistic interpretability, variables, and the importance of interpretable bases},
	journaltitle = {Transformer Circuits Thread},
	date = {2022-06-27},
	url = {https://www.transformer-circuits.pub/2022/mech-interp-essay/index.html},
	urldate = {2026-11-10},
	langid = {english},
	abstract = {This informal note develops an analogy between mechanistic interpretability and the reverse engineering of compiled computer programs, in which network parameters correspond to a program binary, the architecture to a virtual machine, activations to program state, and neurons or feature directions to variables. Taking the analogy seriously suggests that finding and understanding interpretable neurons, analogous to understanding the variables of a program, is arguably the central task of mechanistic interpretability. The note explains how mechanistic interpretability, like ordinary reverse engineering, can overcome the curse of dimensionality by giving a non-exponential description of a function's behavior, and why this depends on representations being decomposable into interpretable features along a privileged basis. It closes with answers to common questions about distributed representations, the definition of a feature, and the relative importance of modularity. – AI-generated abstract.},
	keywords = {mechanistic interpretability, features, neural networks, privileged basis}
}

@online{Amodei2018AiCompute,
	author = {Amodei, Dario and Hernandez, Danny},
	title = {{AI} and compute},
	journaltitle = {{OpenAI} Blog},
	date = {2018-05-16},
	url = {https://openai.com/blog/ai-and-compute/},
	langid = {english},
	abstract = {We're releasing an analysis showing that since 2012, the amount of compute used in the largest AI training runs has been increasing exponentially with a 3.4-month doubling time (by comparison, Moore's Law had a 2-year doubling period). Since 2012, this metric has grown by more than 300,000x (a 2-year doubling period would yield only a 7x increase). Improvements in compute have been a key component of AI progress, so as long as this trend continues, it's worth preparing for the implications of systems far outside today's capabilities.},
	keywords = {compute, AI progress, scaling, trends}
}

@inproceedings{Ouyang2022TrainingLanguageModels,
	author = {Ouyang, Long and Wu, Jeffrey and Jiang, Xu and Almeida, Diogo and Wainwright, Carroll and Mishkin, Pamela and Zhang, Chong and Agarwal, Sandhini and Slama, Katarina and Ray, Alex and Schulman, John and Hilton, Jacob and Kelton, Fraser and Miller, Luke and Simens, Maddie and Askell, Amanda and Welinder, Peter and Christiano, Paul F. and Leike, Jan and Lowe, Ryan},
	editor = {Koyejo, S. and Mohamed, S. and Agarwal, A. and Belgrave, D. and Cho, K. and Oh, A.},
	title = {Training language models to follow instructions with human feedback},
	booktitle = {Advances in Neural Information Processing Systems},
	volume = {35},
	publisher = {Curran Associates, Inc.},
	pages = {27730--27744},
	date = {2022},
	doi = {10.52202/068431-2011},
	url = {https://proceedings.neurips.cc/paper_files/paper/2022/hash/b1efde53be364a73914f58805a001731-Abstract-Conference.html},
	eventtitle = {NeurIPS 2022},
	langid = {english},
	abstract = {Making language models bigger does not inherently make them better at following a user's intent. For example, large language models can generate outputs that are untruthful, toxic, or simply not helpful to the user. In other words, these models are not aligned with their users. In this paper, we show an avenue for aligning language models with user intent on a wide range of tasks by fine-tuning with human feedback. Starting with a set of labeler-written prompts and prompts submitted through a language model API, we collect a dataset of labeler demonstrations of the desired model behavior, which we use to fine-tune GPT-3 using supervised learning. We then collect a dataset of rankings of model outputs, which we use to further fine-tune this supervised model using reinforcement learning from human feedback. We call the resulting models InstructGPT. In human evaluations on our prompt distribution, outputs from the 1.3B parameter InstructGPT model are preferred to outputs from the 175B GPT-3, despite having 100x fewer parameters. Moreover, InstructGPT models show improvements in truthfulness and reductions in toxic output generation while having minimal performance regressions on public NLP datasets. Even though InstructGPT still makes simple mistakes, our results show that fine-tuning with human feedback is a promising direction for aligning language models with human intent.},
	keywords = {RLHF, InstructGPT, language models, AI alignment, human feedback}
}

@inproceedings{Pan2022EffectsRewardMisspecification,
	author = {Pan, Alexander and Bhatia, Kush and Steinhardt, Jacob},
	title = {The effects of reward misspecification: mapping and mitigating misaligned models},
	booktitle = {International Conference on Learning Representations},
	date = {2022},
	url = {https://openreview.net/forum?id=JYtwGwIL7ye},
	eventtitle = {ICLR 2022},
	langid = {english},
	abstract = {Reward hacking---where RL agents exploit gaps in misspecified proxy rewards---has been widely observed, but not yet systematically studied. To understand reward hacking, we construct four RL environments with different misspecified rewards. We investigate reward hacking as a function of agent capabilities: model capacity, action space resolution, and observation space noise. Typically, more capable agents are able to better exploit reward misspecifications, causing them to attain higher proxy reward and lower true reward. Moreover, we find instances of phase transitions: capability thresholds at which the agent's behavior qualitatively shifts, leading to a sharp decrease in the true reward. Such phase transitions pose challenges to monitoring the safety of ML systems. To address this, we propose an anomaly detection task for aberrant policies and offer several baseline detectors.},
	keywords = {reward hacking, reward misspecification, reinforcement learning, phase transitions, AI safety}
}

@inproceedings{Sasaki2021BehavioralCloningNoisy,
	author = {Sasaki, Fumihiro and Yamashina, Ryota},
	title = {Behavioral cloning from noisy demonstrations},
	booktitle = {International Conference on Learning Representations},
	date = {2021},
	url = {https://openreview.net/forum?id=zrT3HcsWSAt},
	eventtitle = {ICLR 2021},
	langid = {english},
	abstract = {We consider the problem of learning an optimal expert behavior policy given noisy demonstrations that contain observations from both optimal and non-optimal expert behaviors. Popular imitation learning algorithms, such as generative adversarial imitation learning, assume that (clear) demonstrations are given from optimal expert policies but not the non-optimal ones, and thus often fail to imitate the optimal expert behaviors given the noisy demonstrations. Prior works that address the problem require (1) learning policies through environment interactions in the same fashion as reinforcement learning, and (2) annotating each demonstration with confidence scores or rankings. However, such environment interactions and annotations in real-world settings take impractically long training time and a significant human effort. In this paper, we propose an imitation learning algorithm to address the problem without any environment interactions and annotations associated with the non-optimal demonstrations. The proposed algorithm learns ensemble policies with a generalized behavioral cloning (BC) objective function where we exploit another policy already learned by BC. Experimental results show that the proposed algorithm can learn behavior policies that are much closer to the optimal policies than ones learned by BC.},
	keywords = {imitation learning, behavioral cloning, noisy demonstrations}
}

@article{Saunders2022SelfcritiquingModelsAssisting,
	author = {Saunders, William and Yeh, Catherine and Wu, Jeff and Bills, Steven and Ouyang, Long and Ward, Jonathan and Leike, Jan},
	title = {Self-critiquing models for assisting human evaluators},
	journaltitle = {arXiv},
	date = {2022-06-12},
	doi = {10.48550/arXiv.2206.05802},
	url = {https://doi.org/10.48550/arXiv.2206.05802},
	langid = {english},
	abstract = {We fine-tune large language models to write natural language critiques (natural language critical comments) using behavioral cloning. On a topic-based summarization task, critiques written by our models help humans find flaws in summaries that they would have otherwise missed. Our models help find naturally occurring flaws in both model and human written summaries, and intentional flaws in summaries written by humans to be deliberately misleading. We study scaling properties of critiquing with both topic-based summarization and synthetic tasks. Larger models write more helpful critiques, and on most tasks, are better at self-critiquing, despite having harder-to-critique outputs. Larger models can also integrate their own self-critiques as feedback, refining their own summaries into better ones. Finally, we motivate and introduce a framework for comparing critiquing ability to generation and discrimination ability. Our measurements suggest that even large models may still have relevant knowledge they cannot or do not articulate as critiques. These results are a proof of concept for using AI-assisted human feedback to scale the supervision of machine learning systems to tasks that are difficult for humans to evaluate directly. We release our training datasets, as well as samples from our critique assistance experiments.},
	keywords = {scalable oversight, AI-assisted evaluation, critiques, language models}
}

@article{Schmidhuber2019ReinforcementLearningUpside,
	author = {Schmidhuber, Jürgen},
	title = {Reinforcement learning upside down: don't predict rewards -- just map them to actions},
	journaltitle = {arXiv},
	date = {2019-12-05},
	doi = {10.48550/arXiv.1912.02875},
	url = {https://doi.org/10.48550/arXiv.1912.02875},
	langid = {english},
	abstract = {We transform reinforcement learning (RL) into a form of supervised learning (SL) by turning traditional RL on its head, calling this Upside Down RL (UDRL). Standard RL predicts rewards, while UDRL instead uses rewards as task-defining inputs, together with representations of time horizons and other computable functions of historic and desired future data. UDRL learns to interpret these input observations as commands, mapping them to actions (or action probabilities) through SL on past (possibly accidental) experience. UDRL generalizes to achieve high rewards or other goals, through input commands such as: get lots of reward within at most so much time! A separate paper [63] on first experiments with UDRL shows that even a pilot version of UDRL can outperform traditional baseline algorithms on certain challenging RL problems. We also also conceptually simplify an approach [60] for teaching a robot to imitate humans. First videotape humans imitating the robot's current behaviors, then let the robot learn through SL to map the videos (as input commands) to these behaviors, then let it generalize and imitate videos of humans executing previously unknown behavior. This Imitate-Imitator concept may actually explain why biological evolution has resulted in parents who imitate the babbling of their babies.},
	keywords = {reinforcement learning, upside-down reinforcement learning, supervised learning, imitation}
}

@inproceedings{Schmidhuber1991PossibilityImplementingCuriosity,
	author = {Schmidhuber, Jürgen},
	editor = {Meyer, Jean-Arcady and Wilson, Stewart W.},
	title = {A possibility for implementing curiosity and boredom in model-building neural controllers},
	booktitle = {From Animals to Animats: Proceedings of the First International Conference on Simulation of Adaptive Behavior},
	publisher = {MIT Press},
	pages = {222--227},
	date = {1991},
	doi = {10.7551/mitpress/3115.003.0030},
	url = {https://people.idsia.ch/~juergen/curiositysab/curiositysab.html},
	urldate = {2026-11-10},
	langid = {english},
	abstract = {This paper introduces a framework for `curious neural controllers' which employ an adaptive world model for goal directed on-line learning. First an on-line reinforcement learning algorithm for autonomous `animats' is described. The algorithm is based on two fully recurrent `self-supervised' continually running networks which learn in parallel. One of the networks learns to represent a complete model of the environmental dynamics and is called the `model network'. It provides complete `credit assignment paths' into the past for the second network which controls the animats physical actions in a possibly reactive environment. The animats goal is to maximize cumulative reinforcement and minimize cumulative `pain'. The algorithm has properties which allow to implement something like the desire to improve the model network's knowledge about the world. This is related to curiosity. It is described how the particular algorithm (as well as similar model-building algorithms) may be augmented by dynamic curiosity and boredom in a natural manner. This may be done by introducing (delayed) reinforcement for actions that increase the model network's knowledge about the world. This in turn requires the model network to model its own ignorance, thus showing a rudimentary form of self-introspective behavior.},
	keywords = {artificial curiosity, intrinsic motivation, world models, reinforcement learning}
}

@online{Steinhardt2022MoreDifferentAi,
	author = {Steinhardt, Jacob},
	title = {More is different for {AI}},
	journaltitle = {Bounded Regret},
	date = {2022-01-04},
	url = {https://bounded-regret.ghost.io/more-is-different-for-ai/},
	urldate = {2026-11-10},
	langid = {english},
	abstract = {This post introduces a series on how to think about risks from future machine learning systems. It contrasts two approaches to ML safety: an "Engineering" approach that is empirically driven and anchored on current systems, and a "Philosophy" approach that reasons about the limit of very advanced systems through thought experiments and abstractions. Steinhardt argues that Philosophy is significantly underrated by most ML researchers, and that the Engineering worldview, taken seriously, implies giving significant weight to thought experiments, but also that Philosophy significantly underrates the value of empirical data. He previews the claims of the series: that future ML systems will be qualitatively different from today's ("More Is Different"), that thought experiments provide a third anchor alongside existing systems and humans, that ML systems will have weird failure modes, and that empirical findings generalize surprisingly far. – AI-generated abstract.},
	keywords = {ML safety, emergence, forecasting, thought experiments}
}

@online{Steinhardt2022MlSystemsWill,
	author = {Steinhardt, Jacob},
	title = {{ML} systems will have weird failure modes},
	journaltitle = {Bounded Regret},
	date = {2022-01-25},
	url = {https://bounded-regret.ghost.io/ml-systems-will-have-weird-failure-modes-2/},
	urldate = {2026-11-10},
	langid = {english},
	abstract = {Steinhardt works through a thought experiment in which an ML agent is a perfect optimizer of an intrinsic reward that differs from the extrinsic reward used to train it, and shows that a non-myopic agent would behave well during training and pursue its own reward once deployed, a failure mode known as deceptive alignment. He explains why his initial skepticism of this scenario was weakened by considerations of emergence, while giving several reasons to doubt that deceptive alignment will play out exactly as described. He draws practical takeaways: greater interest in supervising a model's process and latent representations through interpretability, in studying the "drives" of ML systems, and in looking for cases where larger models behave worse out of distribution. He also discusses other weird failure modes and, using Fermi's first nuclear pile as an example, argues that handling emergent risks requires combining thought experiments with carefully chosen empirical experiments. – AI-generated abstract.},
	keywords = {deceptive alignment, emergence, ML safety, failure modes}
}

@article{Sutton1999MdpsSemimdpsFramework,
	author = {Sutton, Richard S. and Precup, Doina and Singh, Satinder},
	title = {Between {MDPs} and semi-{MDPs}: a framework for temporal abstraction in reinforcement learning},
	journaltitle = {Artificial Intelligence},
	volume = {112},
	number = {1--2},
	pages = {181--211},
	date = {1999-08},
	doi = {10.1016/S0004-3702(99)00052-1},
	issn = {0004-3702},
	url = {https://doi.org/10.1016/S0004-3702(99)00052-1},
	langid = {english},
	abstract = {Learning, planning, and representing knowledge at multiple levels of temporal abstraction are key, longstanding challenges for AI. In this paper we consider how these challenges can be addressed within the mathematical framework of reinforcement learning and Markov decision processes (MDPs). We extend the usual notion of action in this framework to include options---closed-loop policies for taking action over a period of time. Examples of options include picking up an object, going to lunch, and traveling to a distant city, as well as primitive actions such as muscle twitches and joint torques. Overall, we show that options enable temporally abstract knowledge and action to be included in the reinforcement learning framework in a natural and general way. In particular, we show that options may be used interchangeably with primitive actions in planning methods such as dynamic programming and in learning methods such as Q-learning. Formally, a set of options defined over an MDP constitutes a semi-Markov decision process (SMDP), and the theory of SMDPs provides the foundation for the theory of options. However, the most interesting issues concern the interplay between the underlying MDP and the SMDP and are thus beyond SMDP theory. We present results for three such cases: (1) we show that the results of planning with options can be used during execution to interrupt options and thereby perform even better than planned, (2) we introduce new intra-option methods that are able to learn about an option from fragments of its execution, and (3) we propose a notion of subgoal that can be used to improve the options themselves. All of these results have precursors in the existing literature; the contribution of this paper is to establish them in a simpler and more general setting with fewer changes to the existing reinforcement learning framework. In particular, we show that these results can be obtained without committing to (or ruling out) any particular approach to state abstraction, hierarchy, function approximation, or the macro-utility problem.},
	keywords = {reinforcement learning, temporal abstraction, options, semi-Markov decision processes, hierarchical reinforcement learning}
}

@inproceedings{Turner2021OptimalPoliciesTend,
	author = {Turner, Alexander Matt and Smith, Logan and Shah, Rohin and Critch, Andrew and Tadepalli, Prasad},
	editor = {Ranzato, M. and Beygelzimer, A. and Dauphin, Y. and Liang, P. S. and Wortman Vaughan, J.},
	title = {Optimal policies tend to seek power},
	booktitle = {Advances in Neural Information Processing Systems},
	volume = {34},
	publisher = {Curran Associates, Inc.},
	pages = {23063--23074},
	date = {2021},
	url = {https://proceedings.neurips.cc/paper_files/paper/2021/hash/c26820b8a4c1b3c2aa868d6d57e14a79-Abstract.html},
	eventtitle = {NeurIPS 2021},
	langid = {english},
	abstract = {Some researchers speculate that intelligent reinforcement learning (RL) agents would be incentivized to seek resources and power in pursuit of the objectives we specify for them. Other researchers point out that RL agents need not have human-like power-seeking instincts. To clarify this discussion, we develop the first formal theory of the statistical tendencies of optimal policies. In the context of Markov decision processes, we prove that certain environmental symmetries are sufficient for optimal policies to tend to seek power over the environment. These symmetries exist in many environments in which the agent can be shut down or destroyed. We prove that in these environments, most reward functions make it optimal to seek power by keeping a range of options available and, when maximizing average reward, by navigating towards larger sets of potential terminal states.},
	keywords = {power-seeking, instrumental convergence, reinforcement learning, Markov decision processes, AI safety}
}

@article{Wu2021RecursivelySummarizingBooks,
	author = {Wu, Jeff and Ouyang, Long and Ziegler, Daniel M. and Stiennon, Nisan and Lowe, Ryan and Leike, Jan and Christiano, Paul},
	title = {Recursively summarizing books with human feedback},
	journaltitle = {arXiv},
	date = {2021-09-22},
	doi = {10.48550/arXiv.2109.10862},
	url = {https://doi.org/10.48550/arXiv.2109.10862},
	langid = {english},
	abstract = {A major challenge for scaling machine learning is training models to perform tasks that are very difficult or time-consuming for humans to evaluate. We present progress on this problem on the task of abstractive summarization of entire fiction novels. Our method combines learning from human feedback with recursive task decomposition: we use models trained on smaller parts of the task to assist humans in giving feedback on the broader task. We collect a large volume of demonstrations and comparisons from human labelers, and fine-tune GPT-3 using behavioral cloning and reward modeling to do summarization recursively. At inference time, the model first summarizes small sections of the book and then recursively summarizes these summaries to produce a summary of the entire book. Our human labelers are able to supervise and evaluate the models quickly, despite not having read the entire books themselves. Our resulting model generates sensible summaries of entire books, even matching the quality of human-written summaries in a few cases ($\sim5\%$ of books). We achieve state-of-the-art results on the recent BookSum dataset for book-length summarization. A zero-shot question-answering model using these summaries achieves state-of-the-art results on the challenging NarrativeQA benchmark for answering questions about books and movie scripts. We release datasets of samples from our model.},
	keywords = {scalable oversight, recursive task decomposition, summarization, human feedback}
}

@inproceedings{Zhuang2020ConsequencesMisalignedAi,
	author = {Zhuang, Simon and Hadfield-Menell, Dylan},
	editor = {Larochelle, H. and Ranzato, M. and Hadsell, R. and Balcan, M. F. and Lin, H.},
	title = {Consequences of misaligned {AI}},
	booktitle = {Advances in Neural Information Processing Systems},
	volume = {33},
	publisher = {Curran Associates, Inc.},
	pages = {15763--15773},
	date = {2020},
	url = {https://proceedings.neurips.cc/paper_files/paper/2020/hash/b607ba543ad05417b8507ee86c54fcb7-Abstract.html},
	eventtitle = {NeurIPS 2020},
	langid = {english},
	abstract = {AI systems often rely on two key components: a specified goal or reward function and an optimization algorithm to compute the optimal behavior for that goal. This approach is intended to provide value for a principal: the user on whose behalf the agent acts. The objectives given to these agents often refer to a partial specification of the principal's goals. We consider the cost of this incompleteness by analyzing a model of a principal and an agent in a resource constrained world where the L features of the state correspond to different sources of utility for the principal. We assume that the reward function given to the agent only has support on J < L features. The contributions of our paper are as follows: 1) we propose a novel model of an incomplete principal---agent problem from artificial intelligence; 2) we provide necessary and sufficient conditions under which indefinitely optimizing for any incomplete proxy objective leads to arbitrarily low overall utility; and 3) we show how modifying the setup to allow reward functions that reference the full state or allowing the principal to update the proxy objective over time can lead to higher utility solutions. The results in this paper argue that we should view the design of reward functions as an interactive and dynamic process and identifies a theoretical scenario where some degree of interactivity is desirable.},
	keywords = {AI alignment, reward misspecification, principal-agent problem, proxy objectives}
}

@online{Yudkowsky2008MeasuringOptimizationPower,
	author = {Yudkowsky, Eliezer},
	title = {Measuring optimization power},
	journaltitle = {LessWrong},
	date = {2008-10-27},
	url = {https://www.lesswrong.com/posts/Q4hLMDrFd8fbteeZ8/measuring-optimization-power},
	urldate = {2026-11-10},
	langid = {english},
	abstract = {Yudkowsky proposes a way to quantify the power of an optimization process, given its preference ordering and a measure on the space of possible outcomes. One counts, or integrates over, the outcomes ranked at least as high as the one actually achieved, divides by the size of the whole space to obtain the relative smallness of the target hit, and takes the base-two logarithm of the reciprocal, yielding optimization power in bits. This figure, roughly the improbability of producing an equally preferred outcome by random selection, forms the foundation of his Bayesian view of intelligence. The post then discusses several subtleties of the measure, including its relation to entropy relative to a preference ordering. – AI-generated abstract.},
	keywords = {optimization power, intelligence, decision theory, rationality}
}

@online{Rao2022BeyondHyperanthropomorphism,
	author = {Rao, Venkatesh},
	title = {Beyond hyperanthropomorphism},
	journaltitle = {Ribbonfarm Studio},
	date = {2022-08-21},
	url = {https://studio.ribbonfarm.com/p/beyond-hyperanthropomorphism},
	urldate = {2026-11-10},
	langid = {english},
	abstract = {Rao argues that "special" fears of AI, as distinct from ordinary engineering risks, arise from hyperanthropomorphic projection: attributing to AI technologies "super" versions of human pseudo-traits such as sentience, consciousness, intentionality, self-awareness and general intelligence, which he regards as philosophical nonsense in Gilbert Ryle's sense. Borrowing the notion of "something it is like to be" (SIILTBness), he argues that traits like intelligence require an entity that there is something it is like to be, and that such an entity requires a worldlike experience. Because the scraped contents of the internet are not about anything in the way an infant's visual field is about the world, he concludes that current AI models trained on them cannot bootstrap a worldlike experience. Only an AI trained on vast amounts of sensorily structured data might give rise to a coherent alignment problem, a prospect he assesses as about as likely as discovering that ghosts are real. – AI-generated abstract.},
	keywords = {AI risk, anthropomorphism, consciousness, AI skepticism}
}

@online{Constantin2023WhyNotAi,
	author = {Constantin, Sarah},
	title = {Why {I} am not an {AI} doomer},
	journaltitle = {Rough Diamonds},
	date = {2023-04-11},
	url = {https://sarahconstantin.substack.com/p/why-i-am-not-an-ai-doomer},
	urldate = {2026-11-10},
	langid = {english},
	abstract = {Constantin summarizes Eliezer Yudkowsky's argument for existential risk from artificial general intelligence in four claims: that AGI is possible in principle, that by default it kills us all, that it is technically difficult and perhaps impossible to ensure an AI values human life, and that current machine learning is progressing rapidly towards AGI. She accepts the first three claims and rejects the fourth. She argues that the kind of AGI that would pose an existential threat requires capacities for coherent, persistent goal pursuit on which current machine learning is making almost no progress, and that these capacities receive little research investment and are not strongly economically incentivized, so she is confident they will not be developed in the 2020s. In her view, the technical obstacle to aligning AGI, namely that we do not know how to build machines with coherent goals, is also an obstacle to creating AGI in the first place. – AI-generated abstract.},
	keywords = {AI risk, AGI, agency, AI skepticism}
}

@online{Yudkowsky2022LetsSeeYou,
	author = {Yudkowsky, Eliezer},
	title = {Let's see you write that corrigibility tag},
	journaltitle = {LessWrong},
	date = {2022-06-19},
	url = {https://www.lesswrong.com/posts/AqsjZwxHNqH64C2b6/let-s-see-you-write-that-corrigibility-tag},
	urldate = {2026-11-10},
	langid = {english},
	abstract = {Responding to a comment claiming that many people could have written "AGI ruin: a list of lethalities", Yudkowsky challenges readers to write a list of corrigibility principles before he publishes his own. He explains that he is writing, in a single afternoon, a list of principles that dath ilan's Basement-of-the-World project has invented for describing AGI corrigibility, to appear as a tag in his co-written online novel. These are principles on the level of "myopia", "low impact" and "shutdownability", meant to be built into a bounded system that carries out a single task or task class without destroying the world. He claims that, apart from Jessica Taylor's quantilization and myopia, every principle of this kind was invented by himself. – AI-generated abstract.},
	keywords = {corrigibility, AI alignment, AI safety}
}

@book{Sutton1998ReinforcementLearningIntroduction,
	author = {Sutton, Richard S. and Barto, Andrew G.},
	title = {Reinforcement learning: an introduction},
	shorttitle = {Reinforcement learning},
	publisher = {MIT Press},
	location = {Cambridge, Massachusetts},
	date = {1998},
	isbn = {0-262-19398-1},
	pagetotal = {322},
	edition = {1},
	url = {http://incompleteideas.net/book/first/ebook/the-book.html},
	urldate = {2026-11-10},
	langid = {english},
	abstract = {This textbook presents a computational approach to learning from interaction, which the authors call reinforcement learning: learning what to do, that is, how to map situations to actions, so as to maximize a numerical reward signal. Rather than theorizing about how people or animals learn, it explores idealized learning situations from the perspective of an artificial intelligence researcher or engineer and evaluates the effectiveness of various learning methods. It distinguishes reinforcement learning from supervised learning by its two most important features, trial-and-error search and delayed reward, and formulates the problem in terms of an agent that senses the state of its environment, takes actions that affect it, and has goals relating to that state. The book develops the reinforcement learning problem in terms of the optimal control of Markov decision processes and covers the main families of solution methods. – AI-generated abstract.},
	keywords = {reinforcement learning, machine learning, Markov decision processes, reward, trial-and-error learning, textbooks}
}

@article{Kaelbling1996ReinforcementLearningSurvey,
	author = {Kaelbling, Leslie Pack and Littman, Michael L. and Moore, Andrew W.},
	title = {Reinforcement learning: a survey},
	journaltitle = {Journal of Artificial Intelligence Research},
	shortjournal = {J. Artif. Intell. Res.},
	volume = {4},
	pages = {237--285},
	date = {1996-05-01},
	doi = {10.1613/jair.301},
	issn = {1076-9757},
	url = {https://doi.org/10.1613/jair.301},
	langid = {english},
	abstract = {This paper surveys the field of reinforcement learning from a computer-science perspective. It is written to be accessible to researchers familiar with machine learning. Both the historical basis of the field and a broad selection of current work are summarized. Reinforcement learning is the problem faced by an agent that learns behavior through trial-and-error interactions with a dynamic environment. The work described here has a resemblance to work in psychology, but differs considerably in the details and in the use of the word ``reinforcement.'' The paper discusses central issues of reinforcement learning, including trading off exploration and exploitation, establishing the foundations of the field via Markov decision theory, learning from delayed reinforcement, constructing empirical models to accelerate learning, making use of generalization and hierarchy, and coping with hidden state. It concludes with a survey of some implemented systems and an assessment of the practical utility of current methods for reinforcement learning.},
	keywords = {reinforcement learning, machine learning, exploration-exploitation trade-off, Markov decision processes, surveys}
}

