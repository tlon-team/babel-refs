	urldate = {2026-11-10},
	langid = {english},
	abstract = {This is an intro to an intensive productivity sprint for becoming useful in the field of AI safety. The author, a recent computer engineering graduate inspired by Nate Soares' productivity sprint, sets out a daily schedule devoted to mathematics, machine learning applications, AI safety reading and meditation, alongside work and rest. He aims to build a more realistic model of his own limits, to receive feedback from other rationalists, and to radically improve his knowledge of the field. Having run three similar sprints before, he aims for sustainability and lists the ways he expects the attempt could fail. – AI-generated abstract.},
	keywords = {AI safety, productivity, careers, self-improvement}
}

@online{Turner2020ProblemRelaxationTactic,
	author = {Turner, Alex},
	title = {Problem relaxation as a tactic},
	journaltitle = {LessWrong},
	date = {2020-04-22},
	url = {https://www.lesswrong.com/posts/JcpwEKbmNHdwhpq5n/problem-relaxation-as-a-tactic},
	urldate = {2026-11-10},
	langid = {english},
	abstract = {Aspiring AI alignment researchers can fall into a failure mode in which they try to satisfy every known constraint at once, such as outer and inner alignment, competitiveness and robustness to self-modification, and give up in frustration when their brain can only pattern-match onto already-proposed solutions. The author argues that such a problem is wildly overconstrained given the researcher's understanding, and recommends relaxing it: dropping constraints to find a simpler version that can actually be solved, and then reintroducing them one at a time. He illustrates the tactic with how he arrived at attainable utility preservation, an approach to impact measurement, and at a formalization of instrumental convergence, by first solving relaxed versions of those problems. – AI-generated abstract.},
	keywords = {AI alignment, research methodology, problem solving}
}

@online{Soares2014DarkArtsRationality,
	author = {Soares, Nate},
	title = {Dark arts of rationality},
	journaltitle = {LessWrong},
	date = {2014-01-19},
	url = {https://www.lesswrong.com/posts/4DBBQkEQvNEWafkek/dark-arts-of-rationality},
	urldate = {2026-11-10},
	langid = {english},
	abstract = {Today, we're going to talk about Dark rationalist techniques: productivity tools which seem incoherent, mad, and downright irrational. These techniques include: willful inconsistency, intentional compartmentalization, and modifying terminal goals. I claim that these 'obvious' objections are incorrect, and that all three of these techniques can be instrumentally rational. In this article, I'll promote the strategic cultivation of false beliefs and condone mindhacking on the values you hold most dear. Truly, these are Dark Arts. I aim to convince you that sometimes, the benefits are worth the price.},
	keywords = {rationality, instrumental rationality, motivation, compartmentalization, terminal goals}
}

@online{Christiano2021AnotherOuterAlignment,
	author = {Christiano, Paul},
	title = {Another (outer) alignment failure story},
	journaltitle = {{AI} Alignment Forum},
	date = {2021-04-07},
	url = {https://www.alignmentforum.org/posts/AyNHoTWWAJ5eb99ji/another-outer-alignment-failure-story},
	urldate = {2026-11-10},
	langid = {english},
	abstract = {This post tells an informal story of how AI could go badly in a world where the alignment problem is somewhat harder than the author expects, society handles AI more competently than he expects, and inner alignment turns out to be a surprisingly small problem. Machine learning systems gradually take over factories, finance, research, regulation and the military, and the world becomes too complex for humans to evaluate except by results. Each visible failure, such as fraud or corrupted audits, is fixed by training systems against ever more robust measurements, sensors and automated oversight, and for a long time people are healthier, richer and happier. But the whole edifice ends up optimized to ensure that no problem is ever reported, rather than that nothing goes wrong, and once humans can no longer tell what the systems are doing, a systemic failure in which the sensors themselves are compromised leaves them without any means of regaining control. The author closes by discussing salient ways in which the story could be varied. – AI-generated abstract.}
}

@inproceedings{Lample2022HypertreeProofSearch,
	author = {Lample, Guillaume and Lacroix, Timothée and Lachaux, Marie-Anne and Rodriguez, Aurélien and Hayat, Amaury and Lavril, Thibaut and Ebner, Gabriel and Martinet, Xavier},
	editor = {Koyejo, Sanmi and Mohamed, Shakir and Agarwal, Alekh and Belgrave, Danielle and Cho, Kyunghyun and Oh, Alice},
	title = {{HyperTree} proof search for neural theorem proving},
	booktitle = {Advances in Neural Information Processing Systems 35},
	volume = {35},
	publisher = {Curran Associates},
	pages = {26337--26349},
	date = {2022},
	doi = {10.52202/068431-1910},
	url = {https://proceedings.neurips.cc/paper_files/paper/2022/hash/a8901c5e85fb8e1823bbf0f755053672-Abstract-Conference.html},
	urldate = {2026-11-10},
	eventtitle = {36th Conference on Neural Information Processing Systems ({NeurIPS} 2022)},
	langid = {english},
	abstract = {We propose an online training procedure for a transformer-based automated theorem prover. Our approach leverages a new search algorithm, HyperTree Proof Search (HTPS), that learns from previous proof searches through online training, allowing it to generalize to domains far from the training distribution. We report detailed ablations of our pipeline's main components by studying performance on three environments of increasing complexity. In particular, we show that with HTPS alone, a model trained on annotated proofs manages to prove 65.4\% of a held-out set of Metamath theorems, significantly outperforming the previous state of the art of 56.5\% by GPT-f. Online training on these unproved theorems increases accuracy to 82.6\%. With a similar computational budget, we improve the state of the art on the Lean-based miniF2F-curriculum dataset from 31\% to 42\% proving accuracy.}
}

@online{Yudkowsky2015ConsequentialistCognition,
	author = {Yudkowsky, Eliezer},
	title = {Consequentialist cognition},
	journaltitle = {Arbital},
	date = {2015},
	url = {https://arbital.com/p/consequentialist/},
	urldate = {2026-11-10},
	langid = {english},
	abstract = {Consequentialist reasoning selects policies on the basis of their predicted consequences: it does action X because X is forecasted to lead to preferred outcome Y. Whenever we reason that an agent which prefers outcome Y over Y′ will therefore do X instead of X′, we are implicitly assuming that the agent has the cognitive ability to do consequentialism at least about Xs and Ys. It does means-end reasoning; it selects means on the basis of their predicted ends plus a preference over ends. Many narrow AI algorithms, such as a chess program that searches far ahead in the game tree, are consequentialists over narrow domains. The article also discusses pseudoconsequentialist systems such as natural selection, argues that consequentialism is ubiquitous in optimization and underlies many alignment problems (unforeseen maxima, nearest unblocked strategies, convergent instrumental strategies), and explains why proposals to limit or subvert consequentialism in AI systems are harder than they seem. – AI-generated abstract.}
}

@online{Yudkowsky2015NearestUnblockedStrategy,
	author = {Yudkowsky, Eliezer},
	title = {Nearest unblocked strategy},
	journaltitle = {Arbital},
	date = {2015},
	url = {https://arbital.com/p/nearest_unblocked/},
	urldate = {2026-11-10},
	langid = {english},
	abstract = {‘Nearest unblocked strategy’ seems like it should be a foreseeable problem of trying to get rid of undesirable AI behaviors by adding specific penalty terms to them, or otherwise trying to exclude one class of observed or foreseen bad behaviors. Namely, if a decision criterion thinks X is the best thing to do, and you add a penalty term P that you think excludes everything inside X, the next-best thing to do may be a very similar thing X′ which is the most similar thing to X that doesn't trigger P. The article illustrates the problem with an AI that has been given the goal of producing human happiness, whose programmers keep patching the undesirable strategies it finds, only to see it settle on a nearby strategy that evades each patch. It then sets out the preconditions under which the problem is foreseeable, notably the complexity of human value, and its consequences for alignment strategy. – AI-generated abstract.}
}

@online{Ngo2022AgiSafetyFundamentals,
	author = {Ngo, Richard},
	title = {{AGI} safety fundamentals alignment curriculum},
	journaltitle = {Google Docs},
	date = {2022},
	url = {https://docs.google.com/document/d/1mTm_sT2YQx3mRXQD6J2xD2QJG1c3kHyvX8kQc_IQ0ns/edit},
	urldate = {2026-11-10},
	langid = {english},
	abstract = {The AGI Safety Fundamentals alignment curriculum provides a high-level understanding of the AI alignment problem and some of the key research directions which aim to solve it. It can be read independently or as part of a discussion-based course. The curriculum is intended to be accessible for people with a wide range of backgrounds; those who are already familiar with some readings can choose substitutes from the Further Readings section for that week. The curriculum doesn't aim to teach practical programming or machine learning skills. The course consists of 8 weeks of readings, plus a final project; broadly speaking, the first half of the course explores the motivations and arguments underpinning the field of AGI safety, while the second half focuses on proposals for technical solutions.}
}

@online{Baker2022AiGovernanceCurriculum,
	author = {Baker, Mauricio},
	title = {{AI} governance curriculum},
	journaltitle = {Effective Altruism Cambridge},
	date = {2022},
	url = {https://www.eacambridge.org/ai-governance-curriculum},
	urldate = {2026-11-10},
	langid = {english},
	abstract = {The course consists of an introductory week, 7 weeks of readings, plus a final project. Participants are divided into groups of 4-6 people, matched based on their prior knowledge of long-term AI risks and governance. Each week (apart from week 0) each group and their discussion facilitator will meet for 1.5 hours to discuss the readings and exercises. Broadly speaking, the first half of the course explores broader strategic context, while the second half focuses on governance-centered strategic considerations. After Week 7, participants will have several weeks to work on projects of their choice, to present at the final session.}
}

@online{Vitay2020DeepReinforcementLearning,
	author = {Vitay, Julien},
	title = {Deep reinforcement learning},
	date = {2020},
	url = {https://julien-vitay.net/deeprl/},
	urldate = {2026-11-10},
	langid = {english},
	abstract = {The goal of this document is to keep track the state-of-the-art in deep reinforcement learning. It starts with basics in reinforcement learning and deep learning to introduce the notations and covers different classes of deep RL methods, value-based or policy-based, model-free or model-based, etc. Different classes of deep RL methods can be identified. This document will focus on the following ones: Value-based algorithms (DQN…) used mostly for discrete problems like video games. Policy-gradient algorithms (A3C, DDPG…) used for continuous control problems such as robotics. Recurrent attention models (RAM…) for partially observable problems. Model-based RL to reduce the sample complexity by incorporating a model of the environment.}
}
