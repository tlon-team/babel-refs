@online{Sotala2018MyAttemptExplain,
	author = {Sotala, Kaj},
	title = {My attempt to explain {Looking}, insight meditation, and enlightenment in non-mysterious terms},
	journaltitle = {LessWrong},
	date = {2018-03-08},
	url = {https://www.lesswrong.com/posts/mELQFMi9egPn5EAjK},
	urldate = {2026-11-10},
	langid = {english},
	abstract = {Responding to claims that "Looking", kensho and enlightenment cannot be explained from a reductionist, third-person perspective, the author offers an intellectual explanation based on several years of meditation practice, popular accounts of Buddhist theory and cognitive psychology. He describes Looking as the ability to notice and defuse from the mental processes that construct one's experience, and enlightenment as the result of training enough mental precision to defuse from the things that cause suffering. He argues that enlightenment changes behavior less than one might expect, since one's existing personality and motivations remain in charge: someone who cares about saving the world keeps working on it, but if the world ends, it will not feel like the end of the world. – AI-generated abstract.},
	keywords = {meditation, enlightenment, suffering, Buddhism, rationality}
}

@online{Sotala2011OvercomingSufferingEmotional,
	author = {Sotala, Kaj},
	title = {Overcoming suffering: emotional acceptance},
	journaltitle = {LessWrong},
	date = {2011-05-29},
	url = {https://www.lesswrong.com/posts/tNnhxNYcXYdJYtQRh/overcoming-suffering-emotional-acceptance},
	urldate = {2026-11-10},
	langid = {english},
	abstract = {Some attention-allocational conflicts cannot be resolved by addressing their content: a fear of public speaking keeps repeating its signal however one tries to resolve it, and must be treated in a non-content-focused way. The author applies the map-territory distinction to emotions: emotions are a feedback and attention-control mechanism that exists to modify behavior, a fear of a dog is a fact about oneself, not about the dog, and emotions are not inherently good or bad unless one treats them as such. It follows that it is always all right to feel good, since the world changes only through one's actions, and that one is never obliged to feel bad, guilty or ashamed. Negative emotions should not be suppressed but accepted as feedback, and the author reports that simply turning his attention to physical or emotional discomfort and observing it nonjudgmentally, a practice related to mindfulness, often makes it feel neutral or even positive. – AI-generated abstract.},
	keywords = {suffering, emotions, acceptance, mental health, rationality}
}

@online{Riggs2018SavingWorld80,
	author = {Riggs, Logan},
	title = {Saving the world in 80 days: prologue},
