@online{Ho2023InternationalInstitutionsAdvanced,
	author = {Ho, Lewis and Barnhart, Joslyn and Trager, Robert and Bengio, Yoshua and Brundage, Miles and Carnegie, Allison and Chowdhury, Rumman and Dafoe, Allan and Hadfield, Gillian and Levi, Margaret and Snidal, Duncan},
	title = {International institutions for advanced {AI}},
	date = {2023-07-10},
	url = {https://arxiv.org/abs/2307.04699},
	urldate = {2026-08-25},
	doi = {10.48550/arXiv.2307.04699},
	langid = {english},
	abstract = {International institutions may have an important role to play in ensuring advanced {AI} systems benefit humanity. International collaborations can unlock {AI}'s ability to further sustainable development, and coordination of regulatory efforts can reduce obstacles to innovation and the spread of benefits. Conversely, the potential dangerous capabilities of powerful and general-purpose {AI} systems create global externalities in their development and deployment, and international efforts to further responsible {AI} practices could help manage the risks they pose. This paper identifies a set of governance functions that could be performed at an international level to address these challenges, and outlines four complementary institutional models that could each perform some of these functions: a Commission on Frontier {AI} facilitating expert consensus on opportunities and risks from advanced {AI}, an Advanced {AI} Governance Organization setting international standards and monitoring compliance, a Frontier {AI} Collaborative promoting access to advanced {AI}, and an {AI} Safety Project supporting safety research.},
	keywords = {international governance, frontier AI, standards, safety}
}

